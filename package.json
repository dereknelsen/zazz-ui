{
  "name": "zazz-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run --no-cache lint:html && vp run --no-cache -r build && vp run --no-cache -r test",
    "dev": "vp run core#build && vp run --parallel --log labeled -F docs -F experiments dev",
    "fmt:html": "eslint --fix \"**/*.html\"",
    "lint:html": "eslint \"**/*.html\"",
    "playground": "vp run experiments#dev",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@html-eslint/eslint-plugin": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@zazz-ui/eslint-plugin": "workspace:*",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "playwright": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
