      "      --gap: 4;",
      "    \"",
      "  >",
      "    <label data-ui=\"toggle\" data-toggle-size=\"icon\">",
      "      <input type=\"checkbox\" aria-label=\"Bold\" />",
      "      <svg",
      "        xmlns=\"http://www.w3.org/2000/svg\"",
      "        viewBox=\"0 0 24 24\"",
