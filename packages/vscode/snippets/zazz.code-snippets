      "              --line-clamp: 2;",
      "              --text: var(--color-muted-foreground);",
      "            \"",
      "          >",
      "            Satellite collars reveal ancient routes herds still follow each dry season across the",
      "            floodplain.",
      "          </p>",
      "        </hgroup>",
      "      </header>",
      "      <footer",
      "        style=\"",
      "          --display: grid;",
      "          --justify: start;",
      "          --pt: 4;",
      "          --gap: 4;",
      "          --border-t: 1;",
      "        \"",
      "      >",
      "        <div",
