      "        <li",
      "          role=\"option\"",
      "          data-autocomplete-slot=\"item\"",
      "          data-ui=\"button\"",
      "          data-button-variant=\"ghost\"",
      "          data-autocomplete-value=\"Blueberry\"",
      "          style=\"--justify: start\"",
      "        >",
      "          Blueberry",
      "        </li>",
      "        <li",
      "          role=\"option\"",
      "          data-autocomplete-slot=\"item\"",
      "          data-ui=\"button\"",
      "          data-button-variant=\"ghost\"",
      "          data-autocomplete-value=\"Cherry\"",
      "          style=\"--justify: start\"",
      "        >",
      "          Cherry",
      "        </li>",
      "        <li",
      "          role=\"option\"",
