  "Zazz: toaster": {
    "prefix": "zazz-toaster",
    "body": [
      "<div",
      "  style=\"",
      "    --display: flex;",
      "    --flex-wrap: wrap;",
      "    --items: center;",
      "    --gap: 4;",
      "  \"",
      ">",
      "  <button",
      "    data-ui=\"button\"",
      "    type=\"button\"",
      "    commandfor=\"$2\"",
      "    command=\"--toast\"",
      "    data-title=\"Event created\"",
      "    data-description=\"Monday, July 13 at 9:00 AM\"",
      "  >",
      "    Show toast",
      "  </button>",
      "  <button",
      "    data-ui=\"button\"",
      "    type=\"button\"",
      "    commandfor=\"$2\"",
      "    command=\"--toast-success\"",
      "    data-title=\"Changes saved\"",
      "  >",
      "    Success",
      "  </button>",
      "  <button",
      "    data-ui=\"button\"",
      "    type=\"button\"",
      "    commandfor=\"$2\"",
      "    command=\"--toast-info\"",
      "    data-title=\"Update available\"",
      "  >",
      "    Info",
      "  </button>",
      "  <button",
      "    data-ui=\"button\"",
      "    type=\"button\"",
      "    commandfor=\"$2\"",
      "    command=\"--toast-warning\"",
      "    data-title=\"Storage almost full\"",
      "  >",
      "    Warning",
      "  </button>",
      "  <button",
      "    data-ui=\"button\"",
      "    type=\"button\"",
      "    commandfor=\"$2\"",
      "    command=\"--toast-destructive\"",
      "    data-title=\"Something went wrong\"",
      "    data-description=\"The request could not be completed.\"",
      "  >",
      "    Error",
      "  </button>",
      "  <button data-ui=\"button\" data-button-variant=\"primary\" type=\"button\" id=\"${1:toaster-action-example}\">",
      "    With action",
      "  </button>",
      "</div>",
      "",
      "<ui-toaster id=\"${2:toaster-example}\" popover=\"manual\"></ui-toaster>",
      "",
      "<script type=\"module\">",
      "  // An action callback can't live in a data attribute, so it needs the imperative API.",
      "  await customElements.whenDefined(\"ui-toaster\");",
      "",
      "  const toastTrigger = document.getElementById(\"toaster-action-example\");",
      "  const handler = () => {",
      "    window.Toaster.toast({",
      "      title: \"Email archived\",",
      "      description: \"The conversation was moved to the archive.\",",
      "      action: { label: \"Undo\", onClick: () => window.Toaster.success(\"Email restored\") \\},",
      "    \\});",
      "  \\};",
      "",
      "  toastTrigger.addEventListener(\"click\", handler);",
      "",
      "  window.addEventListener(\"unload\", () => {",
      "    toastTrigger.removeEventListener(\"click\", handler);",
      "  \\});",
      "</script>"
    ],
    "description": "toaster.css: Toaster (ui-toaster | [data-ui~=\"toaster\"], [data-toaster-slot~=\"toast\"]) Stacked toast notifications: newest toast in front, older toasts peeking behind, expand on hover."
  },
  "Zazz: toggle": {
    "prefix": "zazz-toggle",
    "body": [
      "<div",
