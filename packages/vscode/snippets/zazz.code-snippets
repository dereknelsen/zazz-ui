  "Zazz: accordion": {
    "prefix": "zazz-accordion",
    "body": [
      "<ui-accordion>",
      "  <details",
      "    style=\"",
      "      --py: 4;",
      "      --border-b: 1;",
      "    \"",
      "  >",
      "    <summary",
      "      style=\"",
      "        --font-weight: strong;",
      "        --text: currentColor;",
      "        --text--hover: var(--color-muted-foreground);",
      "      \"",
      "    >",
      "      What is an accordion?",
      "      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\">",
      "        <rect width=\"256\" height=\"256\" fill=\"none\" />",
      "        <polyline",
      "          points=\"208 96 128 176 48 96\"",
      "          fill=\"none\"",
      "          stroke=\"currentColor\"",
      "          stroke-linecap=\"round\"",
      "          stroke-linejoin=\"round\"",
      "          stroke-width=\"16\"",
      "        />",
      "      </svg>",
      "    </summary>",
      "    <div style=\"--pb: 4\">",
      "      <p>",
      "        A disclosure widget built from the native <code>&lt;details&gt;</code> and",
      "        <code>&lt;summary&gt;</code> elements. The open/close animation uses the",
      "        <code>::details-content</code> pseudo-element — no JavaScript.",
      "      </p>",
      "    </div>",
      "  </details>",
      "  <details",
      "    style=\"",
      "      --py: 4;",
      "      --border-b: 1;",
      "    \"",
      "  >",
      "    <summary",
      "      style=\"",
      "        --font-weight: strong;",
      "        --text: currentColor;",
      "        --text--hover: var(--color-muted-foreground);",
      "      \"",
      "    >",
      "      How does it work?",
      "      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\">",
      "        <rect width=\"256\" height=\"256\" fill=\"none\" />",
      "        <polyline",
      "          points=\"208 96 128 176 48 96\"",
      "          fill=\"none\"",
      "          stroke=\"currentColor\"",
      "          stroke-linecap=\"round\"",
      "          stroke-linejoin=\"round\"",
      "          stroke-width=\"16\"",
      "        />",
      "      </svg>",
      "    </summary>",
      "    <div style=\"--pb: 4\">",
      "      <p>",
      "        Each item is a separate <code>&lt;details&gt;</code>, so several can stay open at once.",
      "        Click a summary or focus it and press Enter to toggle.",
      "      </p>",
      "    </div>",
      "  </details>",
      "  <details",
      "    style=\"",
      "      --py: 4;",
      "      --border-b: 1;",
      "    \"",
      "  >",
      "    <summary",
      "      style=\"",
      "        --font-weight: strong;",
      "        --text: currentColor;",
      "        --text--hover: var(--color-muted-foreground);",
      "      \"",
      "    >",
      "      Why use it?",
      "      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\">",
      "        <rect width=\"256\" height=\"256\" fill=\"none\" />",
      "        <polyline",
      "          points=\"208 96 128 176 48 96\"",
      "          fill=\"none\"",
      "          stroke=\"currentColor\"",
      "          stroke-linecap=\"round\"",
      "          stroke-linejoin=\"round\"",
      "          stroke-width=\"16\"",
      "        />",
      "      </svg>",
      "    </summary>",
      "    <div style=\"--pb: 4\">",
      "      <p>",
      "        Keyboard support, state, and accessibility come from the platform — Zazz only styles the",
      "        chrome through theme tokens.",
      "      </p>",
      "    </div>",
      "  </details>",
      "</ui-accordion>"
    ],
    "description": "accordion.css: Accordion (ui-accordion | [data-ui~=\"accordion\"] on <details>/<summary>)"
  },
  "Zazz: alert-dialog": {
    "prefix": "zazz-alert-dialog",
    "body": [
      "<button",
      "  data-ui=\"button\"",
      "  type=\"button\"",
      "  data-button-variant=\"destructive\"",
      "  command=\"show-modal\"",
      "  commandfor=\"$1\"",
      ">",
      "  Delete account",
      "</button>",
      "<dialog",
      "  id=\"${1:alert-dialog-example-1}\"",
      "  data-ui=\"dialog alert-dialog\"",
      "  role=\"alertdialog\"",
      "  aria-labelledby=\"$2\"",
      "  aria-describedby=\"$3\"",
      "  closedby=\"none\"",
      ">",
      "  <div data-dialog-slot=\"content\">",
      "    <header",
      "      style=\"",
      "        --display: flex;",
      "        --items: center;",
      "        --gap: 2;",
      "      \"",
      "      data-dialog-slot=\"header\"",
      "    >",
      "      <svg style=\"--size: 6\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\">",
      "        <rect width=\"256\" height=\"256\" fill=\"none\" />",
      "        <path",
      "          fill=\"currentColor\"",
      "          d=\"M236.8,188.09,149.35,36.22h0a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM120,104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm8,88a12,12,0,1,1,12-12A12,12,0,0,1,128,192Z\"",
      "        />",
      "      </svg>",
      "      <h2",
      "        style=\"",
      "          --font-size: var(--font-size-lg);",
      "          --font-weight: strong;",
      "          --font-family: var(--font-family-heading);",
      "        \"",
      "        id=\"${2:alert-dialog-example-1-title}\"",
      "      >",
      "        Are you absolutely sure?",
      "      </h2>",
      "    </header>",
      "    <div style=\"--font-style: italic\" data-dialog-slot=\"body\" id=\"${3:alert-dialog-example-1-body}\">",
      "      <p>",
      "        Alert dialogs must be closed by clicking the Cancel or Continue buttons. Changing",
      "        <code>closedby=\"none\"</code> to <code>closedby=\"any\"</code> allows the user to close the",
      "        dialog by clicking outside the dialog or pressing the Escape key.",
      "      </p>",
      "    </div>",
      "  </div>",
      "  <footer data-dialog-slot=\"footer\">",
      "    <button data-ui=\"button\" type=\"button\" commandfor=\"$1\" command=\"close\">",
      "      Cancel",
      "    </button>",
      "    <button",
      "      data-ui=\"button\"",
      "      data-button-variant=\"destructive\"",
      "      type=\"button\"",
      "      commandfor=\"$1\"",
      "      command=\"close\"",
      "    >",
      "      Delete account",
      "    </button>",
      "  </footer>",
      "</dialog>"
    ],
    "description": "alert-dialog.css: Alert dialog ([data-ui~=\"alert-dialog\"] on a [data-ui~=\"dialog\"] <dialog>)"
  },
  "Zazz: autocomplete": {
