  "Zazz: command": {
    "prefix": "zazz-command",
    "body": [
      "<ui-command",
      "  data-command-hotkey=\"mod+k\"",
      "  style=\"",
      "    --w: 100%;",
      "    --max-w: 96;",
      "  \"",
      ">",
      "  <button",
      "    data-ui=\"button\"",
      "    type=\"button\"",
      "    data-button-variant=\"outline\"",
      "    popovertarget=\"$1\"",
      "    data-command-slot=\"open\"",
      "    style=\"",
      "      --justify: space-between;",
      "      --w: 100%;",
      "    \"",
      "  >",
      "    <span style=\"--text: var(--color-muted-foreground)\">Search...</span>",
      "    <ui-kbd-group><kbd>⌘</kbd><kbd>K</kbd></ui-kbd-group>",
      "  </button>",
      "  <div",
      "    id=\"${1:command-example-1}\"",
      "    data-command-slot=\"panel\"",
      "    data-popover-side=\"bottom\"",
      "    data-popover-align=\"start\"",
      "    popover=\"auto\"",
      "  >",
      "    <header data-command-slot=\"header\">",
      "      <input",
      "        data-command-slot=\"input\"",
      "        type=\"text\"",
      "        placeholder=\"Type a command or search...\"",
      "        role=\"combobox\"",
      "        aria-expanded=\"false\"",
      "        aria-autocomplete=\"list\"",
      "        autocomplete=\"off\"",
      "        aria-label=\"Search commands\"",
      "      />",
      "    </header>",
      "    <div role=\"listbox\" data-command-slot=\"list\" aria-label=\"Commands\">",
      "      <div role=\"group\" data-command-slot=\"group\" aria-labelledby=\"$2\">",
      "        <span",
      "          data-command-slot=\"group-label\"",
      "          id=\"${2:command-example-1-nav}\"",
      "          style=\"",
      "            --display: inline-flex;",
      "            --font-size: var(--font-size-eyebrow);",
      "            --font-weight: strong;",
      "            --font-weight: var(--font-weight-eyebrow);",
      "            --leading: var(--leading-eyebrow);",
      "            --tracking: var(--tracking-eyebrow);",
      "            --text-transform: uppercase;",
      "            --text: var(--color-muted-foreground);",
      "          \"",
      "          >Navigation</span",
      "        >",
      "        <a",
      "          role=\"option\"",
      "          data-command-slot=\"item\"",
      "          data-ui=\"button\"",
      "          data-button-variant=\"ghost\"",
      "          href=\"#docs\"",
      "          tabindex=\"-1\"",
      "          data-command-keywords=\"documentation guides\"",
      "          data-command-hotkey=\"mod+shift+d\"",
      "          style=\"--justify: start\"",
      "        >",
      "          Go to docs",
      "          <ui-kbd-group><kbd>⇧</kbd><kbd>⌘</kbd><kbd>D</kbd></ui-kbd-group>",
      "        </a>",
      "        <a",
      "          role=\"option\"",
      "          data-command-slot=\"item\"",
      "          data-ui=\"button\"",
      "          data-button-variant=\"ghost\"",
      "          href=\"#settings\"",
      "          tabindex=\"-1\"",
      "          data-command-keywords=\"preferences options\"",
      "          data-command-hotkey=\"mod+shift+s\"",
      "          style=\"--justify: start\"",
      "        >",
      "          Go to settings",
      "          <ui-kbd-group><kbd>⇧</kbd><kbd>⌘</kbd><kbd>S</kbd></ui-kbd-group>",
      "        </a>",
      "      </div>",
      "      <div role=\"group\" data-command-slot=\"group\" aria-labelledby=\"$3\">",
      "        <span",
      "          data-command-slot=\"group-label\"",
      "          id=\"${3:command-example-1-actions}\"",
      "          style=\"",
      "            --display: inline-flex;",
      "            --font-size: var(--font-size-eyebrow);",
      "            --font-weight: strong;",
      "            --font-weight: var(--font-weight-eyebrow);",
      "            --leading: var(--leading-eyebrow);",
      "            --tracking: var(--tracking-eyebrow);",
      "            --text-transform: uppercase;",
      "            --text: var(--color-muted-foreground);",
      "          \"",
      "          >Actions</span",
      "        >",
      "        <button",
      "          role=\"option\"",
      "          data-command-slot=\"item\"",
      "          data-ui=\"button\"",
      "          data-button-variant=\"ghost\"",
      "          type=\"button\"",
      "          command=\"show-modal\"",
      "          commandfor=\"$4\"",
      "          tabindex=\"-1\"",
      "          data-command-keywords=\"modal open\"",
      "          style=\"--justify: start\"",
      "        >",
      "          Open example dialog",
      "        </button>",
      "      </div>",
      "    </div>",
      "    <p",
      "      data-command-slot=\"empty\"",
      "      style=\"",
      "        --font-size: var(--font-size-sm);",
      "        --leading: var(--leading-sm);",
      "        --tracking: var(--tracking-sm);",
      "        --text: var(--color-muted-foreground);",
      "      \"",
      "    >",
      "      No commands found.",
      "    </p>",
      "    <footer data-command-slot=\"footer\">",
      "      <span",
      "        ><ui-kbd-group><kbd>↑</kbd><kbd>↓</kbd></ui-kbd-group> navigate</span",
      "      >",
      "      <span><kbd>↵</kbd> select</span>",
      "      <span><kbd>esc</kbd> close</span>",
      "    </footer>",
      "  </div>",
      "</ui-command>",
      "",
      "<dialog id=\"${4:command-example-1-dialog}\" data-ui=\"dialog\" closedby=\"any\">",
      "  <div data-dialog-slot=\"content\">",
      "    <header data-dialog-slot=\"header\">",
      "      <h2",
      "        style=\"",
      "          --font-size: var(--font-size-lg);",
      "          --font-weight: strong;",
      "          --font-family: var(--font-family-heading);",
      "          --leading: var(--leading-lg);",
      "          --tracking: var(--tracking-lg);",
      "        \"",
      "      >",
      "        Opened by a command",
      "      </h2>",
      "    </header>",
      "    <div data-dialog-slot=\"body\">",
      "      <p>The command item is a plain invoker button (no custom wiring).</p>",
      "    </div>",
      "  </div>",
      "  <footer data-dialog-slot=\"footer\">",
      "    <button data-ui=\"button\" type=\"button\" commandfor=\"$4\" command=\"close\">",
      "      Close",
      "    </button>",
      "  </footer>",
      "</dialog>"
    ],
    "description": "command.css: Command (ui-command | [data-ui~=\"command\"], [data-command-slot~=\"panel\"])"
  },
