    { "kind": "class", "from": "min-inline-screen-md", "to": "min-inline-screen-lg" },
    { "kind": "class", "from": "min-inline-screen-lg", "to": "min-inline-screen-xl" },
    { "kind": "class", "from": "min-inline-screen-xl", "to": "min-inline-screen-2xl" },
    { "kind": "class", "from": "min-h-screen-xs", "to": "min-h-screen-sm" },
    { "kind": "class", "from": "min-h-screen-sm", "to": "min-h-screen-md" },
    { "kind": "class", "from": "min-h-screen-md", "to": "min-h-screen-lg" },
    { "kind": "class", "from": "min-h-screen-lg", "to": "min-h-screen-xl" },
    { "kind": "class", "from": "min-h-screen-xl", "to": "min-h-screen-2xl" },
