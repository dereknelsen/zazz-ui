{
  "name": "dialog",
  "summary": "dialog.css — Dialog ([data-ui~=\"dialog\"] on native <dialog>; slots data-dialog-slot=\"content | header | body | footer | close\")",
  "identities": [
    "dialog"
  ],
  "tags": [],
  "hooks": {
    "Box Model & Sizing": {
      "--ui-dialog-h": "fit-content",
      "--ui-dialog-mobile-size": "layout-bleed",
      "--ui-dialog-w": "min(var(--layout-sm), 100% - var(--gutters) * 2)"
    },
    "Color & Backgrounds": {
      "--ui-dialog-backdrop-color": "var(--color-shade-900)",
      "--ui-dialog-bg": "var(--color-card)",
      "--ui-dialog-text": "var(--color-card-foreground)"
    },
    "Borders & Outlines": {
      "--ui-dialog-border-color": "var(--color-border)",
      "--ui-dialog-border-style": "solid",
      "--ui-dialog-border-width": "1px",
      "--ui-dialog-corner-shape": "var(--radius-corner-shape)",
      "--ui-dialog-radius": "var(--radius-lg)"
    },
    "Visual Effects": {
      "--ui-dialog-backdrop-filter": "none",
      "--ui-dialog-opacity--end": "1",
      "--ui-dialog-opacity--start": "0",
      "--ui-dialog-shadow": "var(--shadow-lg)"
    },
    "Transforms & Animation": {
      "--ui-dialog-backdrop-transition-duration": "calc(var(--ui-dialog-transition-duration) / 2)",
      "--ui-dialog-backdrop-transition-timing-function": "var(--bezier-easing)",
      "--ui-dialog-scale--end": "1",
      "--ui-dialog-scale--start": "0.98",
      "--ui-dialog-transition-delay--end": "0ms",
      "--ui-dialog-transition-delay--start": "0ms",
      "--ui-dialog-transition-duration": "var(--default-transition-duration)",
      "--ui-dialog-transition-timing-function": "var(--default-transition-timing-function)",
      "--ui-dialog-translate--end": "0, 0, 0",
      "--ui-dialog-translate--start": "0, 0, 0"
    }
  },
  "attributes": {
    "data-dialog-size": [
      "2xl",
      "bleed",
      "full",
      "lg",
      "md",
      "sm",
      "xl"
    ]
  },
  "slots": {
    "data-dialog-slot": [
      "body",
      "close",
      "content",
      "footer",
      "header"
    ]
  },
  "states": {},
  "requires": [],
  "files": {
    "css": [
      "primitives/dialog/dialog.css"
    ],
    "js": [],
    "base": [],
    "examples": [
      "primitives/dialog/dialog.html",
      "primitives/dialog/dialog-with-form.html"
    ]
  }
}
