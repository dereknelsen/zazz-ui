{
  "name": "password-group",
  "summary": "password-group.css — Password group ([data-ui~=\"password-group\"])",
  "identities": [
    "password-group"
  ],
  "tags": [
    "ui-password"
  ],
  "hooks": {
    "Layout & Positioning": {
      "--ui-password-group-display": "flex",
      "--ui-password-group-flex-wrap": "wrap",
      "--ui-password-group-gap": "var(--spacing)",
      "--ui-password-group-items": "center"
    },
    "Box Model & Sizing": {
      "--ui-password-group-min-h": "var(--ui-field-h)",
      "--ui-password-group-p": "0",
      "--ui-password-group-textarea-min-h": "3lh",
      "--ui-password-group-textarea-px": "calc(var(--spacing) * 2)",
      "--ui-password-group-textarea-py": "calc(var(--spacing) * 1.5)",
      "--ui-password-group-w": "100%"
    },
    "Typography": {
      "--ui-password-group-font-size": "var(--font-size-sm)",
      "--ui-password-group-font-weight": "var(--font-weight-strong)"
    },
    "Color & Backgrounds": {
      "--ui-password-group-text": "var(--color-muted-foreground)"
    },
    "Interaction & UI": {
      "--ui-password-group-cursor": "text"
    }
  },
  "attributes": {
    "data-password-group-align": [
      "block-end",
      "block-start",
      "inline-end",
      "inline-start"
    ],
    "data-password-group-label-hide": [],
    "data-password-group-label-show": []
  },
  "slots": {
    "data-password-group-slot": [
      "addon",
      "icon",
      "icon-hide",
      "icon-show",
      "text",
      "toggle"
    ]
  },
  "states": {},
  "requires": [
    "fields",
    "input",
    "button"
  ],
  "files": {
    "css": [
      "primitives/password-group/password-group.css"
    ],
    "js": [
      "primitives/password-group/password-group.js"
    ],
    "base": [],
    "examples": [
      "primitives/password-group/password-group.html"
    ]
  }
}
