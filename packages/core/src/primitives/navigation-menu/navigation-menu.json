{
  "name": "navigation-menu",
  "summary": "navigation-menu.css: Navigation menu ([data-ui~=\"navigation-menu\"])",
  "identities": [
    "navigation-menu"
  ],
  "tags": [],
  "hooks": {
    "Layout & Positioning": {
      "--ui-navigation-menu-popover-gap": "calc(var(--spacing) * 1.5)",
      "--ui-navigation-menu-popover-viewport-display": "grid",
      "--ui-navigation-menu-popover-viewport-gap": "calc(var(--spacing) * 1.5)",
      "--ui-navigation-menu-popover-viewport-items": "stretch",
      "--ui-navigation-menu-popover-viewport-justify-items": "stretch",
      "--ui-navigation-menu-popover-viewport-template-cols": "1fr"
    },
    "Box Model & Sizing": {
      "--ui-navigation-menu-popover-viewport-min-w": "calc(var(--spacing) * 52)",
      "--ui-navigation-menu-popover-w": "min(var(--article-sm), 100% - var(--space-md))"
    },
    "Borders & Outlines": {
      "--ui-navigation-menu-popover-child-corner-shape": "var(--radius-corner-shape)",
      "--ui-navigation-menu-popover-child-radius": "var(--radius-sm)"
    },
    "Visual Effects": {
      "--ui-navigation-menu-popover-shadow": "var(--shadow-md)"
    },
    "Transforms & Animation": {
      "--ui-navigation-menu-icon-transform": "rotate(-180deg)",
      "--ui-navigation-menu-icon-transition": "transform var(--default-transition-duration) var(--default-transition-timing-function)"
    }
  },
  "attributes": {
    "data-navigation-menu-animation": [
      "slide-down"
    ],
    "data-navigation-menu-size": [
      "container",
      "root",
      "screen"
    ],
    "data-navigation-menu-variant": [
      "submenu"
    ]
  },
  "slots": {
    "data-navigation-menu-slot": [
      "item",
      "link",
      "list",
      "marker",
      "popover",
      "submenu",
      "submenu-trigger",
      "trigger",
      "viewport"
    ]
  },
  "states": {},
  "requires": [
    "popover",
    "button"
  ],
  "files": {
    "css": [
      "primitives/navigation-menu/navigation-menu.css"
    ],
    "js": [],
    "base": [],
    "examples": [
      "primitives/navigation-menu/navigation-menu.html",
      "primitives/navigation-menu/navigation-menu-simple.html",
      "primitives/navigation-menu/navigation-menu-interest.html",
      "primitives/navigation-menu/navigation-menu-featured.html",
      "primitives/navigation-menu/navigation-menu-icon-grid.html",
      "primitives/navigation-menu/navigation-menu-megamenu.html"
    ]
  }
}
