      "border-color--hover"
    ],
    "switch": [
      "thumb-bg--hover",
      "track-bg--checked",
      "track-bg--hover"
    ],
    "table": [
      "row-bg--hover"
    ],
    "tabs": [
      "label-bg--active",
      "label-bg--hover",
