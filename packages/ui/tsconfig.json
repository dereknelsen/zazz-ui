{
  "compilerOptions": {
    // Emit contract: readable, unminified JS next to each .ts source (in-place emit,
    // no outDir), with comments preserved and .d.ts + maps for editor types.
    // erasableSyntaxOnly keeps the emitted JS line-for-line close to the source.
    "target": "ES2022",
    // ESNext.Disposable types `using` declarations (Explicit Resource Management).
    // With target ES2022, tsc compiles `using` to try/finally — see
    // CONVENTIONS.scripts.md ("Scoped resources").
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "removeComments": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  // Tests are type-checked via tsconfig.test.json and run by `vp test`; they
  // must never be emitted next to the sources (src/ is published raw).
  "exclude": ["src/**/*.test.ts"]
}
