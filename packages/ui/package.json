{
  "name": "@zazzdesign/ui",
  "version": "0.0.0",
  "description": "Zazz Design Framework — a zero-build, semantic-token CSS + vanilla JS UI kit built on modern web standards.",
  "homepage": "https://github.com/dereknelsen/zazz-monorepo#readme",
  "bugs": {
    "url": "https://github.com/dereknelsen/zazz-monorepo/issues"
  },
  "license": "MIT",
  "author": "Derek Nelsen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dereknelsen/zazz-monorepo.git",
    "directory": "packages/ui"
  },
  "style": "dist/zazz.css",
  "files": [
    "dist",
    "src",
    "examples",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": true,
  "unpkg": "dist/zazz.js",
  "jsdelivr": "dist/zazz.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./index.css": "./src/index.css",
    "./zazz.css": "./dist/zazz.css",
    "./zazz.js": "./dist/zazz.js",
    "./head": {
      "types": "./src/head.d.ts",
      "default": "./src/head.js"
    },
    "./manifest": {
      "types": "./src/manifest.d.ts",
      "default": "./src/manifest.js"
    },
    "./ui/*": "./src/ui/*",
    "./base/*": "./src/base/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vp pack && node scripts/generate-heads.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "heads": "node scripts/generate-heads.mjs",
    "test": "tsc -p tsconfig.test.json && vp test run",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "embla-carousel": "catalog:",
    "embla-carousel-auto-scroll": "catalog:",
    "embla-carousel-autoplay": "catalog:",
    "embla-carousel-class-names": "catalog:",
    "signal-polyfill": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "bumpp": "^11.1.0",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
