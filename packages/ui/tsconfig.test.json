{
  // Type-checks everything including *.test.ts (which the build config excludes
  // from its in-place emit). Never emits.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    // Tests may use node: builtins (e.g. head.test.ts reads package.json files).
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
