{
  "name": "zazz-ui",
  "version": "0.3.2",
  "description": "CLI for the Zazz Design Framework — vendors primitives from @zazz-ui/core into your project, with provenance-tracked updates.",
  "keywords": [
    "cli",
    "design-system",
    "ui-kit",
    "vendor",
    "zazz"
  ],
  "homepage": "https://zazz.sh",
  "bugs": {
    "url": "https://github.com/dereknelsen/zazz-ui/issues"
  },
  "license": "MIT",
  "author": "Derek Nelsen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dereknelsen/zazz-ui.git",
    "directory": "packages/cli"
  },
  "bin": {
    "zazz-ui": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "tsc -p tsconfig.json && vp test run",
    "check": "vp check",
    "prepublishOnly": "vp run --no-cache build"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@npmcli/config": "catalog:",
    "chalk": "catalog:",
    "commander": "catalog:",
    "diff": "catalog:",
    "node-diff3": "catalog:",
    "pacote": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pacote": "catalog:",
    "tar": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
