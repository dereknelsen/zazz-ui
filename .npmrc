# Font Awesome Kit packages (the docs site's icons) come from Font Awesome's registry.
# The token is not here: pnpm ignores ${VAR} credentials in a project .npmrc. Set it at
# user level (`pnpm config set //npm.fontawesome.com/:_authToken <token>`). CI does the
# same from the FONTAWESOME_NPM_AUTH_TOKEN repository secret (.github/workflows/ci.yml).
@awesome.me:registry=https://npm.fontawesome.com/
@fortawesome:registry=https://npm.fontawesome.com/
