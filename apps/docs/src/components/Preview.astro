---
/**
 * `{% preview src="button/button" /%}`: one example fragment from the kit,
 * rendered live in an isolated iframe and shown as code (HTML, the primitive's
 * CSS, and its scripts) from that same string, so the two can never drift.
 */
import { Code } from "astro:components";
import { ExternalLink, Maximize, Minimize } from "@lucide/astro";
import { readExample, readKitFile, readPrimitiveCss } from "../lib/kit.ts";
import { encodeCode } from "../lib/playground-hash.ts";
import { buildPreviewDocument, nextPreviewId, previewMeta, primitiveOf, scriptsFor } from "../lib/preview.ts";

interface Props {
  src: string;
  title?: string;
}
const { src, title } = Astro.props;
const html = readExample(src);
if (html === null) throw new Error(`{% preview %}: example "${src}" is not in @zazz-ui/core`);

const meta = previewMeta(src);
const scriptFiles = scriptsFor(src);
const scripts = scriptFiles.length > 0 || meta.scripts === true;
const js = scriptFiles
  .map((file) => `// ${file}\n${readKitFile(file) ?? ""}`)
  .join("\n\n")
  .trim();
const css = readPrimitiveCss(primitiveOf(src));
const doc = buildPreviewDocument(html, meta, scripts);
const playgroundHref = `/playground/#${await encodeCode(html)}`;
const uid = `pv-${src.replace(/[^a-z0-9]+/gi, "-")}-${nextPreviewId()}`;
const tabs = [
  { id: "preview", label: "Preview" },
  { id: "html", label: "HTML" },
  ...(css ? [{ id: "css", label: "CSS" }] : []),
  ...(js ? [{ id: "js", label: "JS" }] : []),
];
const themes = { light: "github-light", dark: "github-dark" } as const;
---

<ui-tabs style="--w: 100%; --my: 6">
  <div data-tabs-slot="list" role="tablist">
    <div data-tabs-slot="indicator" aria-hidden="true"></div>
    {
      tabs.map((tab, i) => (
        <>
          <input type="radio" role="tab" name={uid} id={`${uid}-${tab.id}`} checked={i === 0} />
          <label for={`${uid}-${tab.id}`} data-tabs-slot="label">
            <span data-tabs-slot="label-text">{tab.label}</span>
          </label>
        </>
      ))
    }
  </div>

  <div data-tabs-slot="panel" role="tabpanel" style="--w: 100%">
    <div
      data-preview-frame
      data-min-height={meta.minHeight ?? 0}
      style="
        --position: relative;
        --border: 1;
        --rounded: var(--radius-md);
        --overflow: clip;
        --bg: var(--color-background);
      "
    >
      {/* allow-same-origin is deliberate: the page measures and themes the frame through contentDocument; the markup is the kit's own. */}
      <iframe
        title={title ?? `Preview: ${src}`}
        srcdoc={doc}
        loading="lazy"
        sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-modals"
        style={`height: ${Math.max(meta.minHeight ?? 0, 160)}px`}></iframe>
      <div
        style="
          --position: absolute;
          --right: 2;
          --bottom: 2;
          --display: flex;
          --gap: 1;
        "
      >
        <a
          href={playgroundHref}
          data-ui="button"
          data-button-variant="outline"
          data-button-size="icon-sm"
          aria-label="Open in playground"
        >
          <ExternalLink size={14} aria-hidden="true" />
        </a>
        <button
          type="button"
          data-ui="button"
          data-button-variant="outline"
          data-button-size="icon-sm"
          data-preview-expand
          aria-label="Expand preview"
        >
          <span data-when="collapsed" style="--display: inline-flex">
            <Maximize size={14} aria-hidden="true" />
          </span>
          <span data-when="expanded" hidden style="--display: inline-flex">
            <Minimize size={14} aria-hidden="true" />
          </span>
        </button>
      </div>
    </div>
  </div>

  <div data-tabs-slot="panel" role="tabpanel" style="--w: 100%">
    <Code code={html} lang="html" themes={themes} defaultColor={false} />
  </div>
  {
    css && (
      <div data-tabs-slot="panel" role="tabpanel" style="--w: 100%">
        <Code code={css} lang="css" themes={themes} defaultColor={false} />
      </div>
    )
  }
  {
    js && (
      <div data-tabs-slot="panel" role="tabpanel" style="--w: 100%">
        <Code code={js} lang="js" themes={themes} defaultColor={false} />
      </div>
    )
  }
</ui-tabs>

<script>
  /**
   * The frame is same-origin (srcdoc), so the page can size it to its stage,
   * mirror the site's theme into it, and reveal it once its styles are in.
   */
  const THEME = "data-ui-theme";
  const root = document.documentElement;

  function setup(frame: HTMLElement): void {
    const iframe = frame.querySelector("iframe");
    if (!iframe) return;
    const minHeight = Number(frame.dataset.minHeight) || 0;

    const stage = () => iframe.contentDocument?.querySelector<HTMLElement>("[data-preview-stage]") ?? null;

    const measure = (): void => {
      if (frame.hasAttribute("data-fullscreen")) return;
      const target = stage() ?? iframe.contentDocument?.documentElement;
      if (!target) return;
      iframe.style.height = `${Math.max(Math.ceil(target.scrollHeight), minHeight, 160)}px`;
    };

    const syncTheme = (): void => {
      const doc = iframe.contentDocument;
      if (!doc) return;
      const theme = root.getAttribute(THEME);
      if (theme) doc.documentElement.setAttribute(THEME, theme);
      else doc.documentElement.removeAttribute(THEME);
    };

    const onLoad = async (): Promise<void> => {
      const doc = iframe.contentDocument;
      if (!doc) return;
      syncTheme();
      const sheets = [...doc.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]')].map(
        (link) =>
          link.sheet
            ? Promise.resolve()
            : new Promise<void>((resolve) => {
                link.addEventListener("load", () => resolve(), { once: true });
                link.addEventListener("error", () => resolve(), { once: true });
              }),
      );
      await Promise.all([...sheets, doc.fonts?.ready]).catch(() => {});
      measure();
      frame.setAttribute("data-loaded", "");
      const observed = stage();
      if (observed) {
        const ro = new ResizeObserver(measure);
        ro.observe(observed);
        for (const child of observed.children) ro.observe(child);
      }
    };

    iframe.addEventListener("load", () => void onLoad());
    if (iframe.contentDocument?.readyState === "complete" && iframe.contentDocument.body?.children.length) {
      void onLoad();
    }
    new MutationObserver(syncTheme).observe(root, { attributes: true, attributeFilter: [THEME] });

    const expand = frame.querySelector<HTMLButtonElement>("[data-preview-expand]");
    expand?.addEventListener("click", () => {
      const on = frame.toggleAttribute("data-fullscreen");
      expand.setAttribute("aria-label", on ? "Collapse preview" : "Expand preview");
      for (const icon of expand.querySelectorAll<HTMLElement>("[data-when]")) {
        icon.hidden = icon.dataset.when !== (on ? "expanded" : "collapsed");
      }
      if (on) iframe.style.height = "100%";
      else measure();
    });
  }

  for (const frame of document.querySelectorAll<HTMLElement>("[data-preview-frame]")) setup(frame);
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    document
      .querySelector<HTMLButtonElement>("[data-preview-frame][data-fullscreen] [data-preview-expand]")
      ?.click();
  });
</script>
