---
/**
 * `{% preview src="button/button" /%}`: one example fragment from the kit,
 * rendered inline (the site loads the whole kit) and shown as code (HTML, the
 * primitive's CSS, and its scripts) from that same string, so the two can never
 * drift. The stage is `not-prose`, so the article's prose styles stop at it, and
 * a container, so breakpoint tiers inside follow the stage's width.
 */
import { Code } from "astro:components";
import { readExample, readKitFile, readPrimitiveCss } from "../lib/kit.ts";
import BandDiagram from "./BandDiagram.astro";
import { liveHtml, nextPreviewId, previewMeta, primitiveOf, scriptsFor } from "../lib/preview.ts";

interface Props {
  src: string;
  title?: string;
}
const { src, title } = Astro.props;
const html = readExample(src);
if (html === null) throw new Error(`{% preview %}: example "${src}" is not in @zazz-ui/core`);

const meta = previewMeta(src);
const js = scriptsFor(src)
  .map((file) => `// ${file}\n${readKitFile(file) ?? ""}`)
  .join("\n\n")
  .trim();
const css = readPrimitiveCss(primitiveOf(src));
const place = meta.inline ?? "center";
const uid = `pv-${src.replace(/[^a-z0-9]+/gi, "-")}-${nextPreviewId()}`;
const tabs = [
  { id: "preview", label: "Preview" },
  { id: "html", label: "HTML" },
  ...(css ? [{ id: "css", label: "CSS" }] : []),
  ...(js ? [{ id: "js", label: "JS" }] : []),
];
const themes = { light: "github-light", dark: "github-dark" } as const;
---

<ui-tabs style="--w: 100%; --my: 6">
  <div data-tabs-slot="list" role="tablist">
    <div data-tabs-slot="indicator" aria-hidden="true"></div>
    {
      tabs.map((tab, i) => (
        <>
          <input type="radio" role="tab" name={uid} id={`${uid}-${tab.id}`} checked={i === 0} />
          <label for={`${uid}-${tab.id}`} data-tabs-slot="label">
            <span data-tabs-slot="label-text">{tab.label}</span>
          </label>
        </>
      ))
    }
  </div>

  <div data-tabs-slot="panel" role="tabpanel" style="--w: 100%">
    <div
      data-preview-frame
      style="
        --border: 1;
        --radius: 2.5;
        --bg: var(--color-background);
      "
    >
      <div
        data-preview-stage
        data-ui="not-prose container"
        data-pagefind-ignore
        role="region"
        aria-label={title ?? `Example: ${src}`}
        style={`--display: grid; --place-items: ${place}; --gap: 6; --p: 6; --pb: 12; --min-h: 40; --overflow-x: auto`}
      >
        {meta.diagram === "bands" ? <BandDiagram /> : <Fragment set:html={liveHtml(html)} />}
      </div>
    </div>
  </div>

  <div data-tabs-slot="panel" role="tabpanel" style="--w: 100%">
    <Code code={html} lang="html" themes={themes} defaultColor={false} />
  </div>
  {
    css && (
      <div data-tabs-slot="panel" role="tabpanel" style="--w: 100%">
        <Code code={css} lang="css" themes={themes} defaultColor={false} />
      </div>
    )
  }
  {
    js && (
      <div data-tabs-slot="panel" role="tabpanel" style="--w: 100%">
        <Code code={js} lang="js" themes={themes} defaultColor={false} />
      </div>
    )
  }
</ui-tabs>

<script>
  /** Links inside a demo stay put (they point at `#` placeholders). */
  document.addEventListener(
    "click",
    (event) => {
      const link = (event.target as Element | null)?.closest?.("[data-preview-stage] a[href]");
      if (link) event.preventDefault();
    },
    true,
  );

</script>
