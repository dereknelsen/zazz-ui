---
import { Menu, X, MoveRight } from "@lucide/astro";
import { getCollection } from "astro:content";
import { links, nav } from "../site.config.ts";
import GithubIcon from "./GithubIcon.astro";
import Logo from "./Logo.astro";
import Search from "./Search.astro";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
const latest = (
  await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<header
  data-ui-persist="header"
  style="
    --display: flex;
    --items: center;
    --h: 12;
    --w: 100%;
    --position: sticky;
    --top: 0;
    --z: 20;
    --bg: var(--color-background);
    --border-b: 1;
  "
>
  <ui-layout style="--w: 100%;">
    <div
      style="
      --display: flex;
      --items: center;
      
      --gap: 1;
    "
    >
      <a
        href="/"
        aria-label="Zazz home"
        style="
        --display: inline-flex;
        --items: center;
        --mr: 3;
        --text: var(--color-foreground);
        --opacity--hover: 0.8;
        --transition: opacity var(--default-transition-duration) var(--default-transition-timing-function);
      "
      >
        <Logo size={20} variant="mark" />
      </a>

      <nav
        aria-label="Primary"
        data-ui="navigation-menu"
        style="
        --display: none;
        --display--md: inline-flex;
        --items: center;
        --gap: 2;
      "
      >
        <menu data-navigation-menu-slot="list">
          {
            nav.map((item) => (
              <li data-navigation-menu-slot="item">
                <a
                  href={item.href}
                  data-ui="button"
                  data-button-variant="ghost"
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                  style="
                  --text: var(--color-muted-foreground);
                  --text--hover: var(--color-foreground);
                  --text--current: var(--color-foreground);
                "
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </menu>
        {
          latest && (
            <a
              href={`/blog/${latest.id}/`}
              data-ui="badge"
              data-badge-variant="info"
            >
              {latest.data.title} <MoveRight />
            </a>
          )
        }
      </nav>

      <div
        style="
        --display: flex;
        --items: center;
        --gap: 2;
        --ml: auto;
        --flex: 1;
      "
      >
        <Search />

        <div style="--display: none; --display--md: block">
          <ThemeToggle name="theme-header" />
        </div>
        <a
          href={links.github}
          data-ui="button"
          data-button-variant="ghost"
          data-button-size="icon"
          aria-label="Zazz on GitHub"
          target="_blank"
          rel="noopener noreferrer"
        >
          <GithubIcon size={16} />
        </a>

        <button
          data-ui="button"
          data-button-variant="ghost"
          data-button-size="icon"
          type="button"
          command="show-modal"
          commandfor="site-menu"
          aria-label="Open menu"
          style="
          --display: inline-flex;
          --display--md: none;
        "
        >
          <Menu size={18} aria-hidden="true" />
        </button>
      </div>
    </div>
  </ui-layout>
</header>

<dialog
  id="site-menu"
  data-ui="dialog mobile-menu"
  data-dialog-size="screen"
  data-mobile-menu-animation="slide-right"
  closedby="any"
  style="--border-width: 0"
>
  <div data-mobile-menu-slot="viewport">
    <div data-mobile-menu-slot="header">
      <Logo size={18} />

      <button
        data-ui="button"
        data-button-variant="ghost"
        data-button-size="icon"
        type="button"
        commandfor="site-menu"
        command="close"
        aria-label="Close menu"
      >
        <X size={18} aria-hidden="true" />
      </button>
    </div>

    <div data-mobile-menu-slot="body">
      <div style="--display: flex-col; --gap: 1">
        <nav aria-label="Menu" style="--display: flex-col; --gap: 1">
          {
            nav.map((item) => (
              <a
                href={item.href}
                data-ui="button"
                data-button-variant="ghost"
                aria-current={isCurrent(item.href) ? "page" : undefined}
                style="--justify: start; --w: 100%; --bg--current: var(--color-muted)"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        {
          latest && (
            <a
              href={`/blog/${latest.id}/`}
              data-ui="button"
              data-button-variant="info"
              style="--mb: 4; --justify: space-between;"
            >
              {latest.data.title} <MoveRight />
            </a>
          )
        }
      </div>
    </div>
    <div
      data-mobile-menu-slot="footer"
      style="
        --display: flex;
        --items: center;
        --justify: space-between;
      "
    >
      <a
        href={links.github}
        data-ui="button"
        data-button-variant="ghost"
        data-button-size="icon"
        aria-label="Zazz on GitHub"
        target="_blank"
        rel="noopener noreferrer"
        rel="noopener"
      >
        <GithubIcon size={16} />
      </a>
      <ThemeToggle name="theme-menu" />
    </div>
  </div>
</dialog>
