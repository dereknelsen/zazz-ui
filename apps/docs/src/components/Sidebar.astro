---
/**
 * Section navigation for Docs and API from `lg` up: a sticky column, rendered
 * fresh on each page; navigations keep its scroll offset. Below `lg` the same
 * links live in `SidebarDrawer`.
 */
import type { SidebarSection } from "../lib/sidebar.ts";
import SidebarNav from "./SidebarNav.astro";

interface Props {
  label: string;
  sections: SidebarSection[];
}
const { label, sections } = Astro.props;
---

<aside
  data-ui="scroll-fade"
  data-scroll-fade-axis="y"
  data-navigation-persist={`sidebar-${label.toLowerCase().replace(/\s+/g, "-")}`}
  data-navigation-persist-mode="scroll"
  style="
    --display: none;
    --display--lg: flex-col;
    --position: sticky;
    --pr: 2;
    --top: 5rem;
    --max-h: calc(100dvh - 6rem);
    --overflow-y: auto;
  "
>
  <nav aria-label={label} style="
      --display: flex-col;
      --gap: 6;
    ">
    <SidebarNav sections={sections} showAnchors />
  </nav>
</aside>
