---
/**
 * Feature clip for the 0.14 release post: swiping toasts in the default
 * `bottom-end` toaster. A 25px drag springs back, a drag past 45px (the kit's
 * SWIPE_DISTANCE in toaster.ts) dismisses, the stack steps forward, and a short
 * quick flick down dismisses too. Titles come from the kit's toaster example.
 * Plain HTML and CSS keyframes on a 10s loop; the base styles are the last frame.
 *
 * Scale: a toast is 356px wide and 16 of its own em here, so its 1em is about
 * 22px (the region sets 1.3em to fill the stage). The meter
 * uses its own scale, 4em to 45px.
 *
 * As in GalleryClip: every `animation` names its keyframes in the shorthand (the
 * minifier turns a nameless one into `none`), and nothing animates `display`.
 */
---

<figure class="fc-ts">
  <div
    class="fc-ts-stage"
    role="img"
    aria-label="A stack of three toasts in the bottom corner. The mouse drags the front toast 25 pixels to the right and lets go, and it springs back. Then it drags it past 45 pixels, and the toast flies off and is dismissed. The next toast steps forward. A quick short flick down dismisses that one too."
  >
    <div class="fc-ts-body" aria-hidden="true">
      <div class="fc-ts-side">
        <div class="fc-ts-labels">
          <span class="fc-ts-label fc-ts-label-1">Under 45px, it springs back.</span>
          <span class="fc-ts-label fc-ts-label-2">Past 45px, it's dismissed.</span>
          <span class="fc-ts-label fc-ts-label-3">The next toast steps forward.</span>
          <span class="fc-ts-label fc-ts-label-4">A quick flick dismisses it too.</span>
        </div>
        <div class="fc-ts-meter">
          <span class="fc-ts-meter-name">Swipe distance</span>
          <span class="fc-ts-track">
            <span class="fc-ts-fill"></span>
            <span class="fc-ts-tick"></span>
          </span>
          <span class="fc-ts-tick-label">45px</span>
        </div>
      </div>
      <div class="fc-ts-region">
        <div class="fc-ts-toast fc-ts-toast-3">
          <b>Update available</b>
          <span>A new version is ready to install.</span>
        </div>
        <div class="fc-ts-toast fc-ts-toast-2">
          <b>Changes saved</b>
          <span>Your profile is up to date.</span>
        </div>
        <div class="fc-ts-toast fc-ts-toast-1">
          <b>Event created</b>
          <span>Monday, July 13 at 9:00 AM</span>
        </div>
      </div>
      <svg class="fc-ts-cursor" viewBox="0 0 16 22">
        <path
          d="M1 1v17.5l4.6-4.4 3 6.6 3-1.4-3-6.4h6.3z"
          fill="#fff"
          stroke="#18181b"
          stroke-width="1.3"
          stroke-linejoin="round"></path>
      </svg>
    </div>
  </div>
</figure>

<style>
  /* Zazz tokens and the toaster's own hooks, except where a value has to scale with the
     clip: the stage sizes in em (2.2cqw), and the kit's spacing and radii are rem, so
     --fc-spacing is an em copy of --spacing and every length is a kit multiple of it.
     The radii read the theme's --radius-multiplier. */
  .fc-ts {
    --fc-spacing: 0.25em;
    --fc-radius-md: calc(var(--fc-spacing) * 2.5 * var(--radius-multiplier));
    --fc-radius: calc(var(--fc-spacing) * 4.5 * var(--radius-multiplier));
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 740 / 415;
    margin: 0;
    margin-block: var(--space-lg);
  }

  .fc-ts-stage {
    position: relative;
    height: 100%;
    overflow: hidden;
    font-family: var(--font-family-body);
    font-size: 2.2cqw;
    color: var(--color-foreground);
    background-color: var(--color-muted);
    border: 0.08em solid var(--color-border);
    border-radius: var(--fc-radius);
  }

  .fc-ts-body {
    position: relative;
    height: 100%;
    animation: fc-ts-loop 10s linear infinite;
  }

  .fc-ts-side {
    position: absolute;
    top: calc(var(--fc-spacing) * 7);
    left: calc(var(--fc-spacing) * 7);
    display: grid;
    gap: calc(var(--fc-spacing) * 6);
  }

  .fc-ts-labels {
    display: grid;
    font-family: var(--font-family-heading);
    font-size: 1.4em;
    font-weight: var(--font-weight-heading);
    line-height: var(--leading-2xl);
    letter-spacing: var(--tracking-h5);
  }

  .fc-ts-label {
    grid-area: 1 / 1;
    opacity: 0;
  }

  .fc-ts-label-1 {
    animation: fc-ts-label-1 10s step-end infinite;
  }

  .fc-ts-label-2 {
    animation: fc-ts-label-2 10s step-end infinite;
  }

  .fc-ts-label-3 {
    animation: fc-ts-label-3 10s step-end infinite;
  }

  .fc-ts-label-4 {
    opacity: 1;
    animation: fc-ts-label-4 10s step-end infinite;
  }

  /* 4em on the track is 45px of swipe */
  .fc-ts-meter {
    display: grid;
    grid-template-columns: 9em;
    gap: calc(var(--fc-spacing) * 1.5);
    font-size: 1em;
  }

  .fc-ts-meter-name {
    font-size: 0.85em;
    color: var(--color-muted-foreground);
  }

  .fc-ts-track {
    position: relative;
    height: calc(var(--fc-spacing) * 2.2);
    background-color: var(--color-card);
    border: 0.08em solid var(--color-border);
    border-radius: var(--radius-full);
  }

  .fc-ts-fill {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 0;
    background-color: var(--color-muted-foreground);
    border-radius: var(--radius-full);
    animation: fc-ts-fill 10s linear infinite;
  }

  .fc-ts-tick {
    position: absolute;
    top: -0.35em;
    bottom: -0.35em;
    left: 4em;
    width: 0.12em;
    background-color: var(--color-foreground);
  }

  .fc-ts-tick-label {
    padding-inline-start: 3.3em;
    font-family: var(--font-family-mono);
    font-size: 0.8em;
    color: var(--color-muted-foreground);
  }

  /* bottom-end, like the default toaster; toasts behind peek out above */
  .fc-ts-region {
    position: absolute;
    right: calc(var(--fc-spacing) * 6.4);
    bottom: calc(var(--fc-spacing) * 6.4);
    width: calc(var(--fc-spacing) * 64);
    height: calc(var(--fc-spacing) * 16.8);
    font-size: 1.3em;
  }

  .fc-ts-toast {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    gap: calc(var(--fc-spacing) * 0.8);
    box-sizing: border-box;
    /* the toaster's hooks: surface, text, border, shadow; padding is --ui-toaster-p's multiple */
    padding: calc(var(--fc-spacing) * 3.2) calc(var(--fc-spacing) * 4);
    font-size: 1em;
    color: var(--ui-toaster-text);
    background-color: var(--ui-toaster-bg);
    border: 0.08em solid var(--ui-toaster-border-color);
    border-radius: var(--fc-radius-md);
    box-shadow: var(--ui-toaster-shadow);
    transform-origin: 50% 0;
  }

  .fc-ts-toast b {
    font-size: 0.85em;
    font-weight: var(--ui-toaster-title-font-weight);
  }

  .fc-ts-toast span {
    font-size: 0.8em;
    color: var(--ui-toaster-description-text);
  }

  /* the stack: each toast behind steps down by --ui-toaster-scale-step, as in the kit */
  .fc-ts-toast-1 {
    opacity: 0;
    translate: 9em 0;
    animation: fc-ts-toast-1 10s linear infinite;
  }

  .fc-ts-toast-2 {
    opacity: 0;
    translate: 0 5em;
    animation: fc-ts-toast-2 10s linear infinite;
  }

  .fc-ts-toast-3 {
    animation: fc-ts-toast-3 10s linear infinite;
  }

  /* the kit hides a tucked toast's content; only the front one reads */
  .fc-ts-toast-2 > * {
    animation: fc-ts-content-2 10s linear infinite;
  }

  .fc-ts-toast-3 > * {
    animation: fc-ts-content-3 10s linear infinite;
  }

  /* the pointer's tip is its top-left corner */
  .fc-ts-cursor {
    position: absolute;
    top: 78.1%;
    left: 58.7%;
    width: 1.1em;
    opacity: 0;
    transform-origin: 0 0;
    animation: fc-ts-cursor 10s linear infinite;
  }

  @keyframes fc-ts-loop {
    0%,
    100% {
      opacity: 0;
    }

    3%,
    96% {
      opacity: 1;
    }
  }

  @keyframes fc-ts-toast-1 {
    0%,
    6% {
      opacity: 1;
      translate: 0 0;
    }

    14% {
      opacity: 1;
      translate: 1.12em 0;
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    19%,
    28% {
      opacity: 1;
      translate: 0 0;
    }

    38% {
      opacity: 1;
      translate: 2.56em 0;
      animation-timing-function: ease-in;
    }

    46%,
    100% {
      opacity: 0;
      translate: 9em 0;
    }
  }

  @keyframes fc-ts-toast-2 {
    0%,
    42% {
      opacity: 1;
      translate: 0 -0.9em;
      scale: calc(1 - var(--ui-toaster-scale-step));
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    50%,
    72% {
      opacity: 1;
      translate: 0 0;
      scale: 1;
    }

    75% {
      opacity: 1;
      translate: 0 0.55em;
      scale: 1;
      animation-timing-function: ease-in;
    }

    82%,
    100% {
      opacity: 0;
      translate: 0 5em;
      scale: 1;
    }
  }

  @keyframes fc-ts-toast-3 {
    0%,
    42% {
      translate: 0 -1.8em;
      scale: calc(1 - 2 * var(--ui-toaster-scale-step));
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    50%,
    78% {
      translate: 0 -0.9em;
      scale: calc(1 - var(--ui-toaster-scale-step));
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    86%,
    100% {
      translate: 0 0;
      scale: 1;
    }
  }

  @keyframes fc-ts-content-2 {
    0%,
    42% {
      opacity: 0;
    }

    48%,
    100% {
      opacity: 1;
    }
  }

  @keyframes fc-ts-content-3 {
    0%,
    80% {
      opacity: 0;
    }

    86%,
    100% {
      opacity: 1;
    }
  }

  /* fill = swipe distance; it turns primary once the swipe counts */
  @keyframes fc-ts-fill {
    0%,
    6% {
      width: 0;
      background-color: var(--color-muted-foreground);
    }

    14% {
      width: 2.2em;
      background-color: var(--color-muted-foreground);
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    19%,
    28% {
      width: 0;
      background-color: var(--color-muted-foreground);
    }

    35.8% {
      width: 4em;
      background-color: var(--color-muted-foreground);
    }

    36% {
      width: 4.1em;
      background-color: var(--color-primary);
    }

    38%,
    42% {
      width: 5.1em;
      background-color: var(--color-primary);
    }

    44%,
    72% {
      width: 0;
      background-color: var(--color-primary);
    }

    75%,
    78% {
      width: 1.1em;
      background-color: var(--color-primary);
    }

    80%,
    100% {
      width: 0;
      background-color: var(--color-muted-foreground);
    }
  }

  /* the tip sits on the front toast's text and moves with the drag */
  @keyframes fc-ts-cursor {
    0%,
    3% {
      top: 78.1%;
      left: 58.7%;
      opacity: 0;
      scale: 1;
    }

    4% {
      top: 78.1%;
      left: 58.7%;
      opacity: 1;
      scale: 1;
    }

    6% {
      top: 78.1%;
      left: 58.7%;
      opacity: 1;
      scale: 0.8;
    }

    14% {
      top: 78.1%;
      left: 61.9%;
      opacity: 1;
      scale: 0.8;
    }

    15% {
      top: 78.1%;
      left: 61.9%;
      opacity: 1;
      scale: 1;
    }

    18% {
      top: 78.1%;
      left: 61.9%;
      opacity: 0;
      scale: 1;
    }

    25% {
      top: 78.1%;
      left: 58.7%;
      opacity: 0;
      scale: 1;
    }

    26% {
      top: 78.1%;
      left: 58.7%;
      opacity: 1;
      scale: 1;
    }

    28% {
      top: 78.1%;
      left: 58.7%;
      opacity: 1;
      scale: 0.8;
    }

    38% {
      top: 78.1%;
      left: 66.02%;
      opacity: 1;
      scale: 0.8;
    }

    39% {
      top: 78.1%;
      left: 66.02%;
      opacity: 1;
      scale: 1;
    }

    42% {
      top: 78.1%;
      left: 66.02%;
      opacity: 0;
      scale: 1;
    }

    69% {
      top: 78.1%;
      left: 58.7%;
      opacity: 0;
      scale: 1;
    }

    70% {
      top: 78.1%;
      left: 58.7%;
      opacity: 1;
      scale: 1;
    }

    72% {
      top: 78.1%;
      left: 58.7%;
      opacity: 1;
      scale: 0.8;
    }

    75% {
      top: 80.9%;
      left: 58.7%;
      opacity: 1;
      scale: 0.8;
    }

    76% {
      top: 80.9%;
      left: 58.7%;
      opacity: 1;
      scale: 1;
    }

    79%,
    100% {
      top: 80.9%;
      left: 58.7%;
      opacity: 0;
      scale: 1;
    }
  }

  @keyframes fc-ts-label-1 {
    0% {
      opacity: 1;
    }

    24% {
      opacity: 0;
    }
  }

  @keyframes fc-ts-label-2 {
    0% {
      opacity: 0;
    }

    24% {
      opacity: 1;
    }

    46% {
      opacity: 0;
    }
  }

  @keyframes fc-ts-label-3 {
    0% {
      opacity: 0;
    }

    46% {
      opacity: 1;
    }

    69% {
      opacity: 0;
    }
  }

  @keyframes fc-ts-label-4 {
    0% {
      opacity: 0;
    }

    69% {
      opacity: 1;
    }
  }

  /* Without motion, show the full stack and the threshold, not the last toast alone. */
  @media (prefers-reduced-motion: reduce) {
    .fc-ts-body,
    .fc-ts-body * {
      animation: none !important;
    }

    .fc-ts-cursor {
      display: none;
    }

    .fc-ts-toast-1 {
      opacity: 1;
      translate: 0 0;
    }

    .fc-ts-toast-2 {
      opacity: 1;
      translate: 0 -0.9em;
      scale: calc(1 - var(--ui-toaster-scale-step));
    }

    .fc-ts-toast-3 {
      translate: 0 -1.8em;
      scale: calc(1 - 2 * var(--ui-toaster-scale-step));
    }

    .fc-ts-toast-2 > *,
    .fc-ts-toast-3 > * {
      opacity: 0;
    }

    .fc-ts-label-2 {
      opacity: 1;
    }

    .fc-ts-label-4 {
      opacity: 0;
    }
  }
</style>
