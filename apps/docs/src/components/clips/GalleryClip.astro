---
/**
 * Feature clip for the 0.13 release post: a `--display: grid-gallery` list
 * gaining children. The column counts are the kit's own (5, 6, then 5 + 2 for
 * seven children), measured in a browser at a width that fits six columns.
 * Plain HTML and CSS keyframes on a 10s loop; the base styles are the last frame.
 *
 * Two constraints shape the CSS. Every `animation` names its keyframes in the
 * shorthand: the build's minifier turns a nameless shorthand into `none`. And the
 * tiles are placed by hand from two registered numbers, because WebKit does not
 * animate `display` in keyframes, so a late child can't join a real grid. The
 * numbers are `<number>`s, so they interpolate: when a child arrives, the tiles
 * slide and resize into the new layout the way the real grid reflows.
 */
---

<figure class="fc-gal">
  <div
    class="fc-gal-stage"
    role="img"
    aria-label="A grid-gallery list with five children sits in one row of five. A sixth child makes one row of six. A seventh makes a row of five and a row of two, not six and one."
  >
    <div class="fc-gal-body" aria-hidden="true">
      <div class="fc-gal-code">
        <span class="fc-gal-punct">&lt;</span>ul <span class="fc-gal-attr">style</span><span
          class="fc-gal-punct">="</span
        ><span class="fc-gal-value">--display: grid-gallery; --gap: 4</span><span
          class="fc-gal-punct">"&gt;</span
        >
      </div>
      <div class="fc-gal-labels">
        <span class="fc-gal-label fc-gal-label-1">5 children: one row of five</span>
        <span class="fc-gal-label fc-gal-label-2">6 children: one row of six</span>
        <span class="fc-gal-label fc-gal-label-3">7 children: 5 + 2, never 6 + 1</span>
      </div>
      <div class="fc-gal-grid">
        <span class="fc-gal-tile"><b>1</b></span>
        <span class="fc-gal-tile"><b>2</b></span>
        <span class="fc-gal-tile"><b>3</b></span>
        <span class="fc-gal-tile"><b>4</b></span>
        <span class="fc-gal-tile"><b>5</b></span>
        <span class="fc-gal-tile fc-gal-tile-6 fc-gal-in-30"><b>6</b></span>
        <span class="fc-gal-tile fc-gal-tile-7 fc-gal-in-55"><b>7</b></span>
      </div>
    </div>
  </div>
</figure>

<style>
  .fc-gal {
    --fc-radius: 1em;
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 740 / 415;
    margin: 0;
    margin-block: 2rem;
  }

  .fc-gal-stage {
    position: relative;
    height: 100%;
    overflow: hidden;
    font-size: 2.2cqw;
    color: var(--color-foreground, #18181b);
    background-color: var(--color-muted, #f4f4f5);
    border: 0.08em solid var(--color-border, #e4e4e7);
    border-radius: var(--fc-radius);
  }

  .fc-gal-body {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 1.1em;
    box-sizing: border-box;
    height: 100%;
    padding: 1.6em;
    animation: fc-gal-loop 10s linear infinite;
  }

  .fc-gal-code {
    padding: 0.8em 1.1em;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 1.05em;
    line-height: 1.4;
    white-space: nowrap;
    background-color: var(--color-card, #fff);
    border: 0.08em solid var(--color-border, #e4e4e7);
    border-radius: calc(var(--fc-radius) * 0.6);
  }

  .fc-gal-punct,
  .fc-gal-attr {
    color: var(--color-muted-foreground, #71717a);
  }

  .fc-gal-value {
    font-weight: 600;
  }

  /* the three labels share one cell; they swap instantly, never mid-fade */
  .fc-gal-labels {
    display: grid;
    font-size: 1.05em;
    font-weight: 600;
    line-height: 1.3;
  }

  .fc-gal-label {
    grid-area: 1 / 1;
    opacity: 0;
  }

  .fc-gal-label-1 {
    animation: fc-gal-label-1 10s step-end infinite;
  }

  .fc-gal-label-2 {
    animation: fc-gal-label-2 10s step-end infinite;
  }

  .fc-gal-label-3 {
    opacity: 1;
    animation: fc-gal-label-3 10s step-end infinite;
  }

  /* --fc-gal-n is the column count and --fc-gal-wrap whether child 6 is on row
     two. Both glide between beats, and every tile works out its own box from
     them, so the row reflows instead of jumping. Two rows fill the grid's height. */
  .fc-gal-grid {
    --fc-gal-n: 5;
    --fc-gal-wrap: 1;
    --fc-gal-gap: 1em;
    --fc-gal-row: calc((100% - var(--fc-gal-gap)) / 2);
    --fc-gal-w: calc((100% - (var(--fc-gal-n) - 1) * var(--fc-gal-gap)) / var(--fc-gal-n));
    position: relative;
    min-height: 0;
    animation: fc-gal-cols 10s linear infinite;
  }

  .fc-gal-tile {
    position: absolute;
    top: 0;
    left: calc(var(--fc-i, 0) * (var(--fc-gal-w) + var(--fc-gal-gap)));
    display: grid;
    place-items: center;
    width: var(--fc-gal-w);
    height: var(--fc-gal-row);
    color: var(--color-primary-foreground, #fff);
    background-color: var(--color-primary, #4f46e5);
    border-radius: calc(var(--fc-radius) * 0.6);
  }

  .fc-gal-tile:nth-child(2) {
    --fc-i: 1;
  }

  .fc-gal-tile:nth-child(3) {
    --fc-i: 2;
  }

  .fc-gal-tile:nth-child(4) {
    --fc-i: 3;
  }

  .fc-gal-tile:nth-child(5) {
    --fc-i: 4;
  }

  .fc-gal-tile b {
    font-size: 1.3em;
    font-weight: 600;
  }

  /* child 6 ends a row of six, or starts row two under a row of five */
  .fc-gal-tile-6 {
    top: calc(var(--fc-gal-wrap) * (var(--fc-gal-row) + var(--fc-gal-gap)));
    left: calc((1 - var(--fc-gal-wrap)) * 5 * (var(--fc-gal-w) + var(--fc-gal-gap)));
  }

  .fc-gal-tile-7 {
    top: calc(var(--fc-gal-row) + var(--fc-gal-gap));
    left: calc(var(--fc-gal-w) + var(--fc-gal-gap));
  }

  /* a child that arrives is invisible until its beat, then pops in */
  .fc-gal-in-30 {
    animation: fc-gal-pop-30 10s ease-out infinite;
  }

  .fc-gal-in-55 {
    animation: fc-gal-pop-55 10s ease-out infinite;
  }

  @property --fc-gal-n {
    syntax: "<number>";
    inherits: true;
    initial-value: 5;
  }

  @property --fc-gal-wrap {
    syntax: "<number>";
    inherits: true;
    initial-value: 1;
  }

  @keyframes fc-gal-loop {
    0%,
    100% {
      opacity: 0;
    }

    3%,
    96% {
      opacity: 1;
    }
  }

  @keyframes fc-gal-cols {
    0%,
    30% {
      --fc-gal-n: 5;
      --fc-gal-wrap: 0;
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    35%,
    55% {
      --fc-gal-n: 6;
      --fc-gal-wrap: 0;
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    61%,
    100% {
      --fc-gal-n: 5;
      --fc-gal-wrap: 1;
    }
  }

  @keyframes fc-gal-label-1 {
    0% {
      opacity: 1;
    }

    30% {
      opacity: 0;
    }
  }

  @keyframes fc-gal-label-2 {
    0% {
      opacity: 0;
    }

    30% {
      opacity: 1;
    }

    55% {
      opacity: 0;
    }
  }

  @keyframes fc-gal-label-3 {
    0% {
      opacity: 0;
    }

    55% {
      opacity: 1;
    }
  }

  @keyframes fc-gal-pop-30 {
    0%,
    30% {
      opacity: 0;
      transform: scale(0.6);
    }

    35%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes fc-gal-pop-55 {
    0%,
    57% {
      opacity: 0;
      transform: scale(0.6);
    }

    61%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fc-gal-body,
    .fc-gal-body * {
      animation: none !important;
    }
  }
</style>
