---
/**
 * Feature clip for the 0.13 release post: a `--display: grid-gallery` list
 * gaining children. The column counts are the kit's own (5, 6, then 5 + 2 for
 * seven children), measured in a browser at a width that fits six columns.
 * Plain HTML and CSS keyframes on a 10s loop; the base styles are the last frame.
 */
---

<figure class="fc-gal">
  <div
    class="fc-gal-stage"
    role="img"
    aria-label="A grid-gallery list with five children sits in one row of five. A sixth child makes one row of six. A seventh makes a row of five and a row of two, not six and one."
  >
    <div class="fc-gal-body" aria-hidden="true">
      <div class="fc-gal-code">
        <span class="fc-gal-punct">&lt;</span>ul <span class="fc-gal-attr">style</span><span
          class="fc-gal-punct">="</span
        ><span class="fc-gal-value">--display: grid-gallery; --gap: 4</span><span
          class="fc-gal-punct">"&gt;</span
        >
      </div>
      <div class="fc-gal-labels">
        <span class="fc-gal-label fc-gal-label-1">5 children: one row of five</span>
        <span class="fc-gal-label fc-gal-label-2">6 children: one row of six</span>
        <span class="fc-gal-label fc-gal-label-3">7 children: 5 + 2, never 6 + 1</span>
      </div>
      <div class="fc-gal-grid">
        <span class="fc-gal-tile">1</span>
        <span class="fc-gal-tile">2</span>
        <span class="fc-gal-tile">3</span>
        <span class="fc-gal-tile">4</span>
        <span class="fc-gal-tile">5</span>
        <span class="fc-gal-tile fc-gal-in-30">6</span>
        <span class="fc-gal-tile fc-gal-in-55">7</span>
      </div>
    </div>
  </div>
</figure>

<style>
  .fc-gal {
    --fc-radius: 1em;
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 740 / 415;
    margin: 0;
  }

  .fc-gal-stage {
    position: relative;
    height: 100%;
    overflow: hidden;
    font-size: 2.2cqw;
    color: var(--color-foreground, #18181b);
    background-color: var(--color-muted, #f4f4f5);
    border: 0.08em solid var(--color-border, #e4e4e7);
    border-radius: var(--fc-radius);
  }

  .fc-gal-body {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 1.1em;
    box-sizing: border-box;
    height: 100%;
    padding: 1.6em;
    animation: fc-gal-loop 10s linear infinite;
  }

  .fc-gal-code {
    padding: 0.8em 1.1em;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 1.05em;
    line-height: 1.4;
    white-space: nowrap;
    background-color: var(--color-card, #fff);
    border: 0.08em solid var(--color-border, #e4e4e7);
    border-radius: calc(var(--fc-radius) * 0.6);
  }

  .fc-gal-punct,
  .fc-gal-attr {
    color: var(--color-muted-foreground, #71717a);
  }

  .fc-gal-value {
    font-weight: 600;
  }

  /* the three labels share one cell; they swap instantly, never mid-fade */
  .fc-gal-labels {
    display: grid;
    font-size: 1.05em;
    font-weight: 600;
    line-height: 1.3;
  }

  .fc-gal-label {
    grid-area: 1 / 1;
    opacity: 0;
    animation: 10s step-end infinite;
  }

  .fc-gal-label-1 {
    animation-name: fc-gal-label-1;
  }

  .fc-gal-label-2 {
    animation-name: fc-gal-label-2;
  }

  .fc-gal-label-3 {
    opacity: 1;
    animation-name: fc-gal-label-3;
  }

  .fc-gal-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-auto-rows: 5.6em;
    align-content: start;
    gap: 1em;
    animation: fc-gal-cols 10s step-end infinite;
  }

  .fc-gal-tile {
    display: grid;
    place-items: center;
    font-size: 1.3em;
    font-weight: 600;
    color: var(--color-primary-foreground, #fff);
    background-color: var(--color-primary, #4f46e5);
    border-radius: calc(var(--fc-radius) * 0.6 / 1.3);
  }

  /* a child that arrives takes no cell until its beat, then pops in */
  .fc-gal-in-30 {
    animation:
      fc-gal-show-30 10s step-end infinite,
      fc-gal-pop-30 10s ease-out infinite;
  }

  .fc-gal-in-55 {
    animation:
      fc-gal-show-55 10s step-end infinite,
      fc-gal-pop-55 10s ease-out infinite;
  }

  @keyframes fc-gal-loop {
    0%,
    100% {
      opacity: 0;
    }

    3%,
    96% {
      opacity: 1;
    }
  }

  @keyframes fc-gal-cols {
    0% {
      grid-template-columns: repeat(5, 1fr);
    }

    30% {
      grid-template-columns: repeat(6, 1fr);
    }

    55% {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @keyframes fc-gal-label-1 {
    0% {
      opacity: 1;
    }

    30% {
      opacity: 0;
    }
  }

  @keyframes fc-gal-label-2 {
    0% {
      opacity: 0;
    }

    30% {
      opacity: 1;
    }

    55% {
      opacity: 0;
    }
  }

  @keyframes fc-gal-label-3 {
    0% {
      opacity: 0;
    }

    55% {
      opacity: 1;
    }
  }

  @keyframes fc-gal-show-30 {
    0% {
      display: none;
    }

    30% {
      display: grid;
    }
  }

  @keyframes fc-gal-show-55 {
    0% {
      display: none;
    }

    55% {
      display: grid;
    }
  }

  @keyframes fc-gal-pop-30 {
    0%,
    30% {
      opacity: 0;
      transform: scale(0.85);
    }

    34%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes fc-gal-pop-55 {
    0%,
    55% {
      opacity: 0;
      transform: scale(0.85);
    }

    59%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fc-gal-body,
    .fc-gal-body * {
      animation: none !important;
    }
  }
</style>
