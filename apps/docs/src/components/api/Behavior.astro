---
/**
 * `{% behavior primitive="tabs" /%}`: the script's own header prose (what it
 * does, its attributes) and the events it dispatches.
 */
import { primitiveApi } from "../../lib/api/primitives.ts";

interface Props {
  primitive: string;
}
const api = primitiveApi(Astro.props.primitive);

/** Inline code spans and bold, nothing else. */
function inline(text: string): string {
  return text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
}

/** Groups header lines into paragraphs and bullet lists. */
function blocks(lines: string[]): { kind: "p" | "ul"; items: string[] }[] {
  const out: { kind: "p" | "ul"; items: string[] }[] = [];
  let current: { kind: "p" | "ul"; items: string[] } | null = null;
  for (const line of lines) {
    if (line.trim() === "") {
      current = null;
      continue;
    }
    if (line.startsWith('- ')) {
      if (current?.kind !== "ul") out.push((current = { kind: "ul", items: [] }));
      current.items.push(line.replace(/^- /, ""));
    } else if (/^\s+\S/.test(line) && current?.kind === "ul") {
      current.items[current.items.length - 1] += ` ${line.trim()}`;
    } else {
      if (current?.kind !== "p") out.push((current = { kind: "p", items: [] }));
      current.items.push(line.trim());
    }
  }
  return out;
}
---

{
  api.behavior.length === 0 ? (
    <p>No script: this primitive is CSS and markup only.</p>
  ) : (
    api.behavior.map((doc) => (
      <section>
        <p data-ui="text-sm" style="--text: var(--color-muted-foreground)">
          <code>{doc.file.replace(/\.ts$/, ".js")}</code>
        </p>
        {blocks(doc.lines).map((block) =>
          block.kind === "ul" ? (
            <ul>
              {block.items.map((item) => (
                <li set:html={inline(item)} />
              ))}
            </ul>
          ) : (
            <p set:html={inline(block.items.join(" "))} />
          ),
        )}
      </section>
    ))
  )
}
{
  api.events.length > 0 && (
    <p>
      Events:{" "}
      {api.events.map((e, i) => (
        <>
          <code>{e}</code>
          {i < api.events.length - 1 ? ", " : ""}
        </>
      ))}
    </p>
  )
}
