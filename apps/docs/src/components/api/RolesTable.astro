---
import { typographyRoles } from "../../lib/api/foundations.ts";
---

<ui-card style="--p: 6; --display: flex-col; --gap: 4; --my: 4">
  {
    typographyRoles().map((role) => (
      <div style="--display: flex; --items: baseline; --gap: 4; --flex-wrap: wrap">
        <code style="--min-w: 20ch">{`data-font="${role}"`}</code>
        <span data-font={role}>The quick brown fox</span>
      </div>
    ))
  }
</ui-card>
