---
/**
 * Light / dark / system, icons only. Behavior lives in scripts/theme-toggle.ts
 * (`<theme-toggle>`, defined by BaseLayout), which names each instance's
 * radios and checks the stored choice.
 */
import { Monitor, Moon, Sun } from "@lucide/astro";

const options = [
  { value: "light", label: "Light theme", Icon: Sun },
  { value: "dark", label: "Dark theme", Icon: Moon },
  { value: "system", label: "System theme", Icon: Monitor },
] as const;
---

<theme-toggle data-ui="toggle-group" role="group" aria-label="Color theme">
  {
    options.map(({ value, label, Icon }) => (
      <label data-ui="toggle" data-toggle-size="icon">
        <input type="radio" name="theme" value={value} aria-label={label} />
        <Icon size={16} aria-hidden="true" />
      </label>
    ))
  }
</theme-toggle>
