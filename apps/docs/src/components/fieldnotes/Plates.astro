---
/**
 * The species plates in a carousel, adapted from the carousel fragment: three
 * plates to a view, stepped with the header's buttons or dragged. A plate
 * opens that species' dialog (SpeciesCard.astro renders it).
 */
import { ChevronLeft, ChevronRight } from '@lucide/astro';
import { species } from '../../lib/fieldnotes.ts';
import Card from './Card.astro';
import CardHeader from './CardHeader.astro';
import Sprite from './Sprite.astro';

const steps = [
  { slot: 'prev', label: 'Previous plate', icon: ChevronLeft },
  { slot: 'next', label: 'Next plate', icon: ChevronRight },
];
---

<Card labelledby='fn-plates-title' span={2}>
  <ui-carousel
    style='
      --display: grid;
      --gap: 4;
    '
  >
    <CardHeader
      id='fn-plates-title'
      title='Plates'
      description='Drawn from the last accepted records.'
    >
      <div style='
          --display: flex;
          --gap: 2;
        '>
        {
          steps.map(({ slot, label, icon: Icon }) => (
            <ui-tooltip>
              <button
                data-ui='button'
                data-button-size='icon'
                data-button-variant='outline'
                data-carousel-slot={slot}
                type='button'
                interestfor={`fn-plates-${slot}`}
                aria-label={label}
              >
                <Icon aria-hidden='true' />
              </button>
              <div data-tooltip-slot='content' id={`fn-plates-${slot}`} popover='hint'>
                {label}
                <span data-tooltip-slot='arrow' aria-hidden='true' />
              </div>
            </ui-tooltip>
          ))
        }
      </div>
    </CardHeader>
    <div data-carousel-slot='viewport'>
      <div data-carousel-slot='container' style='--gap: 4'>
        {
          species.map((s) => (
            <button
              data-carousel-slot='slide'
              type='button'
              command='show-modal'
              commandfor={`fn-species-${s.slug}`}
              style='
                --display: grid;
                --basis: calc((100% - var(--space-sm) * 2) / 3);
                --p: 0;
                --gap: 2;
                --text-align: start;
                --bg: transparent;
                --focus-ring: -2;
                --radius: 2.5;
              '
            >
              <span
                style='
                  --display: grid;
                  --place-items: center;
                  --aspect: 1;
                  --border: 1;
                  --radius: 2.5;
                '
              >
                <Sprite slug={s.slug} size={24} />
              </span>
              <span style='--display: grid'>
                <span data-ui='text-sm' style='--font-weight: strong'>
                  {s.name}
                </span>
                <span
                  class='fieldnotes__num'
                  data-ui='text-sm'
                  style='--text: var(--color-muted-foreground)'
                >
                  {s.range}, {s.lastSeen}
                </span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </ui-carousel>
</Card>
