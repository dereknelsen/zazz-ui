---
/**
 * The next trip: habitat filters adapted from the multiple toggle-group fragment,
 * with the checked state themed to the secondary role through the toggle's
 * `--ui-toggle-*--checked` hooks; the party in the avatar pile; secondary and
 * tertiary actions.
 */
import { Bookmark, UserPlus } from '@lucide/astro';
import { spotters } from '../../lib/fieldnotes.ts';
import Avatars from './Avatars.astro';
import CardHeader from './CardHeader.astro';

const habitats = [
  { value: 'forest', label: 'Forest', checked: true },
  { value: 'coast', label: 'Coast', checked: true },
  { value: 'wetland', label: 'Wetland', checked: false },
  { value: 'upland', label: 'Upland', checked: false },
];
const party = spotters.filter((s) => ['YO', 'JA', 'VE'].includes(s.initials));
---

<section
  data-ui='card'
  data-card-variant='outline'
  aria-labelledby='fn-trip-title'
  style='
    --gap: 5;
    --mb: 6;
    --bg: var(--color-card);
    --elevation: 1.5;
    --template-cols: minmax(min-content, 1fr);
  '
>
  <CardHeader
    id='fn-trip-title'
    title='Next trip'
    description='Mauritius, 14 to 21 March. Dodo country.'
  />
  <div style='--display: grid; --gap: 2'>
    <span id='fn-trip-habitats' data-ui='text-sm' style='--font-weight: strong'>Habitats</span>
    <ui-toggle-group
      role='group'
      aria-labelledby='fn-trip-habitats'
      style='
        --ui-toggle-bg--checked: var(--color-secondary);
        --ui-toggle-bg--checked-hover: oklch(from var(--color-secondary) l c h / 0.9);
        --ui-toggle-bg--checked-active: oklch(from var(--color-secondary) l c h / 0.8);
        --ui-toggle-text--checked: var(--color-secondary-foreground);
        --ui-toggle-text--checked-hover: var(--color-secondary-foreground);
        --ui-toggle-text--checked-active: var(--color-secondary-foreground);
        --ui-toggle-border-color--checked: var(--color-secondary);
        --ui-toggle-border-color--checked-hover: var(--color-secondary);
        --ui-toggle-border-color--checked-active: var(--color-secondary);
      '
    >
      {
        habitats.map((h) => (
          <label data-ui='toggle'>
            <input type='checkbox' name='trip-habitat' value={h.value} checked={h.checked} />
            <span>{h.label}</span>
          </label>
        ))
      }
    </ui-toggle-group>
  </div>
  <div style='--display: flex; --items: center; --gap: 3'>
    <Avatars
      initials={party.map((p) => p.initials)}
      label={`Going: ${party.map((p) => p.name).join(', ')}`}
    />
    <span data-ui='text-sm' style='--text: var(--color-muted-foreground)'>
      {party.length} going
    </span>
  </div>
  <div style='--display: grid; --grid-cols: 2; --gap: 2'>
    <button data-ui='button' data-button-variant='secondary' type='button'>
      <Bookmark aria-hidden='true' /> Save trip
    </button>
    <button data-ui='button' data-button-variant='tertiary' type='button'>
      <UserPlus aria-hidden='true' /> Invite
    </button>
  </div>
</section>
