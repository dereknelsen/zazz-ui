---
/**
 * An overlapping row of initials avatars, named as a group by `label`. The
 * roles are solid, so an overlapped avatar never shows through.
 */
import Avatar from './Avatar.astro';

interface Props {
  initials: string[];
  label: string;
}
const { initials, label } = Astro.props;
---

<div role='img' aria-label={label} style='--display: flex'>
  {initials.map((text, i) => <Avatar initials={text} stacked overlap={i > 0} />)}
</div>
