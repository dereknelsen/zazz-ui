---
/**
 * An overlapping row of initials avatars (the avatar fragment's fallback face),
 * each in its person's accent role (`avatarRole`). The roles are solid, so an
 * overlapped avatar never shows through.
 */
import { avatarRole } from '../../lib/fieldnotes.ts';

interface Props {
  initials: string[];
  label: string;
}
const { initials, label } = Astro.props;
---

<div role='img' aria-label={label} style='--display: flex'>
  {
    initials.map((text, i) => (
      <span
        aria-hidden='true'
        data-ui='text-2xs'
        style={`
          --display: grid;
          --place-items: center;
          --size: 8;
          --ml: ${i === 0 ? 0 : -2};
          --font-weight: strong;
          --text: var(--color-${avatarRole(text)}-foreground);
          --bg: var(--color-${avatarRole(text)});
          --radius: full;
          --ring: 2;
          --ring-color: var(--color-card);
        `}
      >
        {text}
      </span>
    ))
  }
</div>
