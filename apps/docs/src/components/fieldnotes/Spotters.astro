---
import { spotters } from '../../lib/fieldnotes.ts';
import Avatar from './Avatar.astro';
import Card from './Card.astro';
import CardHeader from './CardHeader.astro';
---

<Card labelledby='fn-spotters-title'>
  <CardHeader
    id='fn-spotters-title'
    title='Spotters'
    description='People on the record for your species.'
  />
  <ul style='
      --display: grid;
      --divide-y: 1;
    '>
    {
      spotters.map((p) => (
        <li
          style='
            --display: flex;
            --items: center;
            --py: 3;
            --gap: 3;
          '
        >
          <Avatar initials={p.initials} size={9} />
          <span
            style='
              --display: grid;
              --min-w: 0;
            '
          >
            <span data-ui='text-sm' style='--font-weight: strong'>
              {p.name}
            </span>
            <span
              data-ui='text-sm'
              style='
                --text-wrap: truncate;
                --text: var(--color-muted-foreground);
              '
            >
              {p.detail}
            </span>
          </span>
        </li>
      ))
    }
  </ul>
</Card>
