---
/**
 * A lock toggle for the theme builder (scripts/theme-builder.ts): pressed, the
 * field named by `field` keeps its value on the next Generate. With `section`
 * it locks or unlocks every field in its accordion section at once. Both lock
 * icons render and the pressed state picks one (`.theme-builder__lock`,
 * site.css), so the button reads right before any script runs.
 *
 * A section's lock goes right before its `<details>`, never in the summary: a
 * button inside a summary is a button in a button. The accordion is a grid, and
 * `row` stacks the lock in its section's row, over the start of the summary
 * (`.theme-builder__section-lock`, site.css).
 */
import Icon from "./Icon.astro";

interface Props {
  /** The `name` of the form field this locks. */
  field?: string;
  /** Locks the whole section instead: its `data-theme-section`. */
  section?: string;
  /** With `section`: the accordion grid row the section sits in. */
  row?: number;
  /** What the lock holds, lowercase: "primary color", "all color fields". */
  label: string;
}
const { field, section, row, label } = Astro.props;
const tip = `tb-lock-${field ?? `all-${section}`}-tip`;
---

<ui-tooltip
  class={section ? "theme-builder__section-lock" : undefined}
  style={section ? `--row-start: ${row}` : "--display: inline-flex;"}
>
  <button
    class="theme-builder__lock"
    data-ui="button"
    data-button-size="icon"
    data-button-variant="outline"
    type="button"
    aria-pressed="false"
    aria-label={`Lock ${label}`}
    interestfor={tip}
    data-theme-lock={field}
    data-theme-lock-all={section}
  >
    <Icon name="lock-open" class="theme-builder__lock-open" aria-hidden="true" />
    <Icon name="lock" class="theme-builder__lock-closed" aria-hidden="true" />
  </button>
  <div data-tooltip-slot="content" data-ui="text-xs" id={tip} popover="hint">
    {section ? `Lock all ${section} styles` : "Lock style"}
    <span data-tooltip-slot="arrow" aria-hidden="true"></span>
  </div>
</ui-tooltip>
