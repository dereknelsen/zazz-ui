---
/** "On this page": h2/h3 anchors; the client marks the one in view. */
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}
const headings = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  headings.length > 0 && (
    <aside
      data-toc
      style="
        --display: none;
        --display--xl: block;
        --position: sticky;
        --top: 5rem;
        --max-h: calc(100dvh - 6rem);
        --overflow-y: auto;
      "
    >
      <nav aria-label="On this page" data-ui="text-sm">
        <h2 data-ui="text-eyebrow" style="--mb: 2">
          On this page
        </h2>
        <ul
          style="
            --display: flex-col;
            --gap: 1.5;
            --border-l: 1;
          "
        >
          {headings.map((h) => (
            <li style={h.depth === 3 ? "--pl: 6" : "--pl: 3"}>
              <a
                href={`#${h.slug}`}
                style="
                  --text: var(--color-muted-foreground);
                  --text--hover: var(--color-foreground);
                  --text-decoration: none;
                "
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )
}

<script>
  const toc = document.querySelector("[data-toc]");
  if (toc) {
    const links = new Map<string, HTMLAnchorElement>();
    for (const a of toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']")) {
      links.set(decodeURIComponent(a.hash.slice(1)), a);
    }
    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    let current: HTMLAnchorElement | undefined;
    const inView = new Set<HTMLElement>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!(entry.target instanceof HTMLElement)) continue;
          if (entry.isIntersecting) inView.add(entry.target);
          else inView.delete(entry.target);
        }
        // Topmost heading still in the band wins; document order is the target order.
        const first = targets.find((t) => inView.has(t));
        if (!first) return;
        const next = links.get(first.id);
        if (!next || next === current) return;
        current?.removeAttribute("aria-current");
        next.setAttribute("aria-current", "true");
        current = next;
      },
      { rootMargin: "-20% 0px -70% 0px" },
    );
    for (const target of targets) observer.observe(target);
  }
</script>
