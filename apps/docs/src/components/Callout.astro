---
import { Info, Lightbulb, TriangleAlert } from "@lucide/astro";

interface Props {
  type?: "note" | "tip" | "warning";
  title?: string;
}
const { type = "note", title } = Astro.props;
const kinds = {
  note: { Icon: Info, label: "Note", variant: "info" },
  tip: { Icon: Lightbulb, label: "Tip", variant: "success" },
  warning: { Icon: TriangleAlert, label: "Warning", variant: "warning" },
} as const;
const kind = kinds[type];
const heading = title ?? kind.label;
---

<aside
  data-ui="callout text-sm"
  data-callout-variant={kind.variant}
  aria-label={heading}
  style="--my: 6"
>
  <p style="--display: flex; --items: center; --gap: 2; --font-weight: strong">
    <kind.Icon size={16} aria-hidden="true" />
    {heading}
  </p>
  <div><slot /></div>
</aside>
