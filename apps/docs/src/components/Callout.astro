---
import Icon from "./Icon.astro";

interface Props {
  type?: "note" | "tip" | "warning";
  title?: string;
}
const { type = "note", title } = Astro.props;
const kinds = {
  note: { icon: "circle-info", label: "Note", variant: "info" },
  tip: { icon: "lightbulb", label: "Tip", variant: "success" },
  warning: { icon: "triangle-exclamation", label: "Warning", variant: "warning" },
} as const;
const kind = kinds[type];
const heading = title ?? kind.label;
---

<aside
  data-ui="callout" data-font="sm"
  data-callout-variant={kind.variant}
  aria-label={heading}
  style="--my: 6"
>
  <p style="
      --display: flex;
      --items: center;
      --gap: 2;
      --font-weight: strong;
    ">
    <Icon name={kind.icon}  />
    {heading}
  </p>
  <div><slot /></div>
</aside>
