---
/**
 * The theme builder: a grid of Fieldnotes cards (a birding app built from Zazz
 * primitives) and a theme form. On wide screens the form is a sticky column on
 * the left; on narrow ones it collapses to a bar at the bottom of the screen,
 * and the form opens in a sheet. Changes apply live to the cards only (the
 * `.fieldnotes__preview` wrapper), live in the URL as a `?preset=` share code
 * until reset (scripts/theme-builder.ts, lib/preset.ts), and
 * copy as a `:root { … }` block of the variables that changed. The card
 * elevation slider restyles the preview but is never part of the copied CSS.
 *
 * Behavior lives in `<theme-builder>` (scripts/theme-builder.ts) and in
 * `<fieldnotes-demo>` / `<fieldnotes-sightings>` (scripts/fieldnotes.ts), which BaseLayout defines
 * on every page, so the component works however its page is reached.
 */
import languageData from "@zazz-ui/core/editor/zazz.language-data.json";
import {
  Check,
  ChevronDown,
  Code,
  Copy,
  Dices,
  RotateCcw,
  SlidersHorizontal,
  WandSparkles,
  X,
} from "@lucide/astro";
import { species } from "../lib/fieldnotes.ts";
import {
  FONT_CATEGORIES,
  LOCAL_FONTS,
  SCALE_STEPS,
  pickGoogleFonts,
  type FontCategory,
  type FontOption,
  type GoogleFontItem,
} from "../lib/fonts.ts";
import {
  BACKGROUNDS,
  DEFAULT_BACKGROUND,
  STOPS,
  toHex,
} from "../lib/palette.ts";
import AlertSettings from "./fieldnotes/AlertSettings.astro";
import LifeList from "./fieldnotes/LifeList.astro";
import SightingForm from "./fieldnotes/SightingForm.astro";
import SightingsTable from "./fieldnotes/SightingsTable.astro";
import SpeciesCard from "./fieldnotes/SpeciesCard.astro";
import Spotters from "./fieldnotes/Spotters.astro";

const TOASTER = "fieldnotes-toaster";

/**
 * The controls' starting values, copied from the kit's tokens in
 * `_variables.css`; a control at its starting value writes nothing. The kit's
 * `--spacing` is fluid (0.225rem to 0.25rem), so 0.25 is the top of that range
 * and the page stays fluid until the value changes.
 */
const defaults = {
  // --color-primary is --color-primary-950 in light mode: oklch(0.145 0 0).
  primary: toHex({ l: 0.145, c: 0, h: 0 }),
  // --color-neutral-500: oklch(0.629 0.012 286.12).
  neutral: toHex({ l: 0.629, c: 0.012, h: 286.12 }),
  spacing: 0.25,
  radius: 1,
  shadow: 0,
  // --radius-corner-shape: superellipse(1.3).
  cornerShape: 1.3,
  // --color-shadow: black.
  shadowColor: "#000000",
  // --default-shadow-intensity / -blur / -distance.
  shadowKnob: 1,
  // --typeset-scale-min / --typeset-scale-max.
  scaleMin: 1.125,
  scaleMax: 1.25,
};

/**
 * The Google families on offer: the seven most popular families of each offered
 * category, fetched once at build with the server-side key. A fork
 * without the key, or an API that fails, gets the local stacks only. The key
 * is never logged and never reaches the page: only names and weights do.
 */
async function googleFonts(): Promise<FontOption[]> {
  const key = import.meta.env.GOOGLE_FONTS_API_KEY;
  if (!key) return [];
  try {
    const url = new URL("https://www.googleapis.com/webfonts/v1/webfonts");
    url.searchParams.set("sort", "popularity");
    url.searchParams.set("key", key);
    // The key is restricted to the site's referrers, so the build introduces
    // itself as the site (there is no browser here to do it).
    const response = await fetch(url, {
      headers: { Referer: Astro.site?.href ?? "" },
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const data = (await response.json()) as { items?: GoogleFontItem[] };
    return pickGoogleFonts(data.items ?? []);
  } catch (error) {
    console.warn(
      `ThemeBuilder: Google Fonts unavailable (${error instanceof Error ? error.message : "error"}); offering local fonts only.`,
    );
    return [];
  }
}

const google = await googleFonts();

/** The combobox groups: the Google families by category, or the local stacks when there are none. */
const CATEGORY_LABEL: Record<FontCategory, string> = {
  "sans-serif": "Sans serif",
  serif: "Serif",
  display: "Display",
  monospace: "Monospace",
};
const fontGroups =
  google.length > 0
    ? FONT_CATEGORIES.map((category) => ({
        label: CATEGORY_LABEL[category],
        fonts: google.filter((f) => f.category === category),
      })).filter((group) => group.fonts.length > 0)
    : [{ label: "System", fonts: LOCAL_FONTS }];

/** The font controls: one family for headings, one for body text. */
const fontRoles = [
  { role: "heading", label: "Heading font", other: "body font" },
  { role: "body", label: "Body font", other: "heading font" },
] as const;
const fontDefault = "Default (system sans)";

const scales = [
  {
    name: "scale-min",
    label: "Scale at narrow widths",
    value: defaults.scaleMin,
  },
  {
    name: "scale-max",
    label: "Scale at wide widths",
    value: defaults.scaleMax,
  },
] as const;

const palettes = [
  {
    name: "primary",
    label: "Primary",
    hint: "Buttons, links, focus rings, and selection.",
  },
  {
    name: "neutral",
    label: "Neutral",
    hint: "Surfaces, borders, and body text.",
  },
] as const;

/** The background selects: one per scheme, each limited to its end of the neutral scale. */
const backgrounds = [
  { scheme: "light", label: "Light background" },
  { scheme: "dark", label: "Dark background" },
] as const;
const backgroundLabel = (pick: string) =>
  pick === "white" ? "White" : pick === "black" ? "Black" : `Neutral ${pick}`;
const backgroundSwatch = (pick: string) =>
  pick === "white" || pick === "black"
    ? `var(--color-${pick})`
    : `var(--color-neutral-${pick})`;

const [featured, ...rest] = species;

/** The collapsed bar's chips (narrow screens): one per control, opening the sheet on that control. */
const chips = [
  { id: "tb-primary-hex", label: "Primary", swatch: "var(--color-primary)" },
  {
    id: "tb-neutral-hex",
    label: "Neutral",
    swatch: "var(--color-neutral-500)",
  },
  { id: "tb-bg-light", label: "Light background" },
  { id: "tb-bg-dark", label: "Dark background" },
  { id: "tb-font-heading", label: "Heading font" },
  { id: "tb-font-body", label: "Body font" },
  { id: "tb-scale-min", label: "Scale min" },
  { id: "tb-scale-max", label: "Scale max" },
  { id: "tb-spacing", label: "Spacing" },
  { id: "tb-radius", label: "Radius" },
  { id: "tb-corner-shape", label: "Corner shape" },
  { id: "tb-elevation", label: "Card elevation" },
  { id: "tb-shadow", label: "Shadow angle" },
  { id: "tb-shadow-intensity", label: "Shadow intensity" },
  { id: "tb-shadow-blur", label: "Shadow blur" },
  { id: "tb-shadow-distance", label: "Shadow distance" },
  {
    id: "tb-shadow-color",
    label: "Shadow color",
    swatch: "var(--color-shadow)",
  },
];

/** The shadow multipliers: one slider each, 0 to 3 times the kit's shadow. */
const SHADOW_KNOBS = [
  {
    key: "intensity",
    label: "Shadow intensity",
    hint: "Darker above 1, lighter below.",
  },
  { key: "blur", label: "Shadow blur", hint: "Softer above 1, crisper below." },
  {
    key: "distance",
    label: "Shadow distance",
    hint: "How far the shadow falls from the surface.",
  },
];

/**
 * The kit resolves its tokens on `:root`, so `--space-md` is a length by the
 * time a card inherits it and a `--spacing` set on the preview alone would
 * change nothing. Re-declaring every derived token and hook (any whose value
 * reads a `var()`) on the preview wrapper makes them recompute there from the
 * live theme, while the rest of the page keeps the site's values. The shadow
 * tokens are re-declared by the kit itself wherever `--shadow-tint` is set, so
 * the wrapper carries a no-op tint instead (see its `style`). Re-declaring
 * `--ui-field-font-size` also drops the kit's iOS-only 16px floor (fields.css),
 * so the preview restores it after the rest, or a focused field zooms the page.
 */
const derived = Object.entries({
  ...languageData.tokens,
  ...languageData.hooks,
})
  .filter(([, { value }]) => value.includes("var("))
  .map(([name, { value }]) => `${name}: ${value};`)
  .join(" ");
const previewScope = `@layer zazz.variables {
  .fieldnotes__preview { ${derived} }
  @supports (-webkit-touch-callout: none) {
    .fieldnotes__preview { --ui-field-font-size: max(16px, var(--font-size-sm)); }
  }
}`;
---

<style is:inline set:html={previewScope}></style>

<fieldnotes-demo
  class="fieldnotes"
  style="
    --display: grid;
    --position: relative;
    --items: start;
    --justify: center;
    --template-cols: minmax(0, 1fr);
    --template-cols--lg: 36ch minmax(0, 1fr);
    --w: 100%;
  "
>
  <!--
    Narrow screens: a bar stuck to the bottom with one chip per control and the
    actions; the form itself moves into the sheet (the dialog) and back as the
    width changes (scripts/theme-builder.ts). Wide screens: the form inline, stuck below the header.
  -->
  <theme-builder
    style="
      --position: sticky;
      --order: 1;
      --order--lg: 0;
      --p: 5;
      --pt--lg: 0;
      --pb--lg: 6;
      --top: auto;
      --top--lg: calc(var(--ui-header-height, 0rem) + 6 * var(--spacing));
      --bottom: 0;
      --bottom--lg: auto;
      --bg-linear: to bottom;
      --bg-stops: transparent 0%, var(--color-background) 50%;
      --z: 30;
    "
  >
    <ui-card
      data-theme="dark"
      data-card-variant="outline"
      data-theme-bar
      style="
        --display: grid;
        --display--lg: none;
        --p: 3;
        --gap: 2;
        --text: var(--color-card-foreground);
        --bg: var(--color-card);
        --radius: 6;
        --pointer-events: auto;
      "
    >
      <div
        data-ui="scroll-fade"
        data-scroll-fade-axis="x"
        style="
          --display: flex;
          --px: 3;
          --py: 0.5;
          --gap: 2;
          --mx: -3;
          --overflow-x: auto;
        "
      >
        {
          chips.map((chip) => (
            <button
              type="button"
              data-ui="button"
              data-button-variant="outline"
              command="show-modal"
              commandfor="tb-sheet"
              data-theme-chip={chip.id}
              style="
                --display: grid;
                --place-items: start;
                --shrink: 0;
                --px: 3;
                --py: 2;
                --gap: 0.5;
                --h: auto;
                --text-align: start;
              "
            >
              <span data-ui="text-xs">{chip.label}</span>
              <span
                style="
                  --display: flex;
                  --items: center;
                  --gap: 2;
                "
              >
                {chip.swatch && (
                  <span
                    aria-hidden="true"
                    data-theme-chip-swatch
                    style={`--size: 3; --bg: ${chip.swatch}; --radius: full; --ring: 1; --ring-color: var(--color-border)`}
                  />
                )}
                <span class="fieldnotes__num" data-theme-chip-value>
                  #000000
                </span>
              </span>
            </button>
          ))
        }
      </div>
      <div
        style="
          --display: grid;
          --grid-cols: 3;
          --gap: 2;
        "
      >
        <button
          data-ui="button"
          data-button-variant="muted"
          type="button"
          data-theme-copy-proxy
        >
          <Copy size={16} aria-hidden="true" /> Copy
        </button>
        <button
          data-ui="button"
          data-button-variant="muted"
          type="button"
          command="show-modal"
          commandfor="tb-sheet"
        >
          <SlidersHorizontal size={16} aria-hidden="true" /> Edit
        </button>
        <button
          data-ui="button"
          data-button-variant="warning"
          type="button"
          data-theme-reset-proxy
        >
          <RotateCcw size={16} aria-hidden="true" /> Reset
        </button>
      </div>
    </ui-card>

    <dialog
      id="tb-sheet"
      data-ui="dialog"
      data-theme="dark"
      closedby="any"
      aria-labelledby="tb-title"
    >
      <div data-dialog-slot="content">
        <div data-dialog-slot="body" data-theme-sheet></div>
      </div>
      <button
        data-ui="button"
        data-dialog-slot="close"
        data-button-size="icon"
        data-button-variant="ghost"
        type="button"
        commandfor="tb-sheet"
        command="close"
        aria-label="Close"
      >
        <X aria-hidden="true" />
      </button>
    </dialog>

    <div
      data-theme-panel
      data-theme="dark"
      style="
        --display: none;
        --display--lg: flex-col;
        --bg: var(--color-card);
        --radius: var(--ui-card-radius);
        --overflow: clip;
      "
    >
      <form
        data-ui="card"
        aria-labelledby="tb-title"
        style="
          --place-items: start stretch;
          --template-rows: auto 1fr auto;
          --gap: 3;
          --h: calc(100vb - var(--ui-header-height, 0rem) - (12 * var(--spacing)));
          --text: var(--color-card-foreground);
          --bg: var(--color-card);
          --overflow-y: auto;
        "
      >
        <header
          style="
            --display: flex-col;
            --position: sticky;
            --p: 5;
            --gap: 3;
            --top: 0;
            --bg: var(--color-card);
            --border-b: 1;
            --z: 10;
          "
        >
          <div
            style="
              --display: flex;
              --items: center;
              --justify: space-between;
              --gap: 2;
            "
          >
            <h2 id="tb-title" data-ui="text-lg">Zazz theme builder</h2>
            <button
              data-ui="button"
              data-button-size="icon"
              data-button-variant="primary"
              type="button"
              aria-label="Randomize the theme"
              data-theme-randomize
            >
              <Dices aria-hidden="true" />
            </button>
          </div>
        </header>

        <!-- Each section is a disclosure: color and type start open, the rest closed. -->
        <ui-accordion>
          <details
            open
            style="
              --py: 3;
              --border-style: dotted;
            "
          >
            <summary
              style="
                --px: 5;
                --font-weight: strong;
              "
            >
              Color
              <ChevronDown data-accordion-slot="marker" aria-hidden="true" />
            </summary>
            <div
              style="
                --display: grid;
                --px: 5;
                --py: 3;
                --gap: 3;
              "
            >
              {
                palettes.map((p) => (
                  <div data-ui="field">
                    <label data-field-slot="label" for={`tb-${p.name}-hex`}>
                      {p.label}
                    </label>
                    <div
                      style="
                        --display: grid;
                        --gap: 2;
                      "
                    >
                      <label data-ui="input-group">
                        <input
                          data-ui="input"
                          id={`tb-${p.name}-hex`}
                          name={`${p.name}-hex`}
                          value={defaults[p.name]}
                          spellcheck="false"
                          autocomplete="off"
                          pattern="#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})"
                          data-theme-hex={p.name}
                        />
                        <span data-input-group-slot="addon">
                          <input
                            type="color"
                            name={`${p.name}-color`}
                            value={defaults[p.name]}
                            aria-label={`${p.label} color picker`}
                            class="theme-builder__swatch"
                            data-theme-color={p.name}
                          />
                        </span>
                      </label>
                      <div
                        role="img"
                        aria-label={`${p.label} palette, 50 to 950`}
                        data-theme-strip={p.name}
                        style="
                          --display: grid;
                          --grid-cols: 11;
                          --gap: 1;
                        "
                      >
                        {STOPS.map((stop) => (
                          <span
                            data-stop={stop}
                            style={`
                            --h: auto;
                            --aspect: 1;
                            --bg: var(--color-${p.name}-${stop});
                            --radius: 1;
                            --ring: 0;
                            --ring--current: 2;
                            --ring-color: var(--color-success-foreground);
                            --ring-offset: 1;
                            --ring-offset-color: var(--color-card);
                          `}
                          />
                        ))}
                      </div>
                    </div>
                    <div data-field-slot="description">
                      <span data-field-slot="hint" data-theme-hint={p.name}>
                        {p.hint}
                      </span>
                    </div>
                  </div>
                ))
              }

              {
                backgrounds.map((b) => (
                  <div data-ui="field">
                    <label data-field-slot="label" for={`tb-bg-${b.scheme}`}>
                      {b.label}
                    </label>
                    <select
                      data-ui="select"
                      data-select-align="center"
                      data-select-side="right"
                      id={`tb-bg-${b.scheme}`}
                      name={`bg-${b.scheme}`}
                      data-default={DEFAULT_BACKGROUND[b.scheme]}
                      data-theme-bg={b.scheme}
                    >
                      <button>
                        <selectedcontent
                          style="
                            --display: flex;
                            --items: center;
                            --gap: 2;
                          "
                        />
                      </button>
                      {BACKGROUNDS[b.scheme].map((pick) => (
                        <option
                          value={pick}
                          selected={pick === DEFAULT_BACKGROUND[b.scheme]}
                        >
                          <span
                            aria-hidden="true"
                            data-theme-bg-swatch={pick}
                            style={`--size: 3; --shrink: 0; --bg: ${backgroundSwatch(pick)}; --radius: full; --ring: 1; --ring-color: var(--color-border)`}
                          />
                          {backgroundLabel(pick)}
                        </option>
                      ))}
                    </select>
                    {b.scheme === "dark" && (
                      <div data-field-slot="description">
                        <span data-field-slot="hint">
                          The preview shows the one for the page's current mode.
                          Text colors come from the neutral palette.
                        </span>
                      </div>
                    )}
                  </div>
                ))
              }
            </div>
          </details>
          <details
            open
            style="
              --py: 3;
              --border-style: dotted;
              --border-t: 1;
            "
          >
            <summary
              style="
                --px: 5;
                --font-weight: strong;
              "
            >
              Type
              <ChevronDown data-accordion-slot="marker" aria-hidden="true" />
            </summary>
            <div
              style="
                --display: grid;
                --px: 5;
                --py: 3;
                --gap: 3;
              "
            >
              {
                fontRoles.map((f) => (
                  <div data-ui="field">
                    <label data-field-slot="label" for={`tb-font-${f.role}`}>
                      {f.label}
                    </label>
                    <div
                      style="
                        --display: flex;
                        --items: center;
                        --gap: 2;
                      "
                    >
                      <ui-combobox
                        style="
                          --flex: 1;
                          --min-w: 0;
                        "
                      >
                        <input
                          type="hidden"
                          name={`font-${f.role}`}
                          value=""
                          data-default=""
                          data-combobox-slot="value"
                          data-theme-font={f.role}
                        />
                        <div data-combobox-slot="control">
                          <input
                            id={`tb-font-${f.role}`}
                            type="text"
                            role="combobox"
                            aria-expanded="false"
                            aria-autocomplete="list"
                            autocomplete="off"
                            spellcheck="false"
                          />
                          <button
                            type="button"
                            data-combobox-slot="trigger"
                            tabindex="-1"
                            aria-label="Show fonts"
                          />
                        </div>
                        <div
                          data-combobox-slot="panel"
                          data-popover-side="right"
                          data-popover-align="start"
                          popover="manual"
                        >
                          <div
                            role="listbox"
                            data-combobox-slot="list"
                            aria-label={`${f.label} options`}
                          >
                            <div
                              role="option"
                              data-combobox-slot="item"
                              data-ui="button"
                              data-button-variant="ghost"
                              data-combobox-value=""
                              aria-selected="true"
                              style="--justify: start"
                            >
                              {fontDefault}
                            </div>
                            {fontGroups.map((group, i) => (
                              <div
                                role="group"
                                data-combobox-slot="group"
                                aria-labelledby={`tb-font-${f.role}-group-${i}`}
                              >
                                <span
                                  id={`tb-font-${f.role}-group-${i}`}
                                  data-combobox-slot="group-label"
                                  data-ui="text-eyebrow"
                                  style="
                                    --pl: 3;
                                    --mt: 2;
                                    --text: var(--color-muted-foreground);
                                  "
                                >
                                  {group.label}
                                </span>
                                {group.fonts.map((font) => (
                                  <div
                                    role="option"
                                    data-combobox-slot="item"
                                    data-ui="button"
                                    data-button-variant="ghost"
                                    data-combobox-value={font.value}
                                    data-font-category={font.category}
                                    data-font-stack={font.stack}
                                    data-font-google={font.google}
                                    data-font-weights={font.weights?.join(";")}
                                    style="--justify: start"
                                  >
                                    {font.label}
                                  </div>
                                ))}
                              </div>
                            ))}
                          </div>
                          <p
                            data-combobox-slot="empty"
                            data-ui="text-sm"
                            style="--text: var(--color-muted-foreground)"
                          >
                            No matches.
                          </p>
                        </div>
                      </ui-combobox>
                      <button
                        data-ui="button"
                        data-button-size="icon"
                        data-button-variant="outline"
                        type="button"
                        aria-label={`Pick a ${f.label.toLowerCase()} that pairs with the ${f.other}`}
                        data-theme-pair={f.role}
                      >
                        <WandSparkles aria-hidden="true" />
                      </button>
                    </div>
                  </div>
                ))
              }

              {
                scales.map((s) => (
                  <div data-ui="field">
                    <label data-field-slot="label" for={`tb-${s.name}`}>
                      {s.label}
                    </label>
                    <select
                      data-ui="select"
                      data-select-align="center"
                      data-select-side="right"
                      id={`tb-${s.name}`}
                      name={s.name}
                      data-default={s.value}
                      data-theme-number={s.name}
                    >
                      <button>
                        <selectedcontent
                          style="
                            --display: flex;
                            --items: center;
                            --gap: 0.35em;
                          "
                        />
                      </button>
                      {SCALE_STEPS.map((step) => (
                        <option
                          value={step.value}
                          selected={step.value === s.value}
                        >
                          <span class="fieldnotes__num">{step.value}</span>
                          {step.name && (
                            <span style="--text: var(--color-muted-foreground)">
                              {step.name}
                            </span>
                          )}
                        </option>
                      ))}
                    </select>
                    {s.name === "scale-max" && (
                      <div data-field-slot="description">
                        <span data-field-slot="hint">
                          Each heading step multiplies by the scale, which grows
                          from the narrow value to the wide one across the fluid
                          range.
                        </span>
                      </div>
                    )}
                  </div>
                ))
              }
            </div>
          </details>
          <details
            open
            style="
              --py: 3;
              --border-style: dotted;
              --border-t: 1;
            "
          >
            <summary
              style="
                --px: 5;
                --font-weight: strong;
              "
            >
              Size &amp; shape
              <ChevronDown data-accordion-slot="marker" aria-hidden="true" />
            </summary>
            <div
              style="
                --display: grid;
                --px: 5;
                --py: 3;
                --gap: 3;
              "
            >
              <div data-ui="field">
                <label data-field-slot="label" for="tb-spacing">Spacing</label>
                <label data-ui="input-group">
                  <input
                    data-ui="input"
                    id="tb-spacing"
                    name="spacing"
                    type="number"
                    min="0"
                    max="2"
                    step="0.01"
                    value={defaults.spacing}
                    data-default={defaults.spacing}
                    data-theme-number="spacing"
                  />
                  <span
                    data-input-group-slot="addon"
                    data-input-group-align="inline-end"
                  >
                    <span data-input-group-slot="text">rem</span>
                  </span>
                </label>
              </div>

              <div data-ui="field">
                <label
                  data-field-slot="label"
                  for="tb-radius"
                  style="
                    --display: flex;
                    --items: center;
                    --justify: space-between;
                  "
                >
                  <span>Radius</span>
                  <output
                    class="fieldnotes__num"
                    for="tb-radius"
                    style="--text: var(--color-muted-foreground)"
                  >
                    {defaults.radius}×
                  </output>
                </label>
                <input
                  id="tb-radius"
                  name="radius"
                  type="range"
                  min="0"
                  max="3"
                  step="0.25"
                  value={defaults.radius}
                  data-default={defaults.radius}
                  data-theme-number="radius"
                />
              </div>

              <div data-ui="field" class="theme-builder__corner-shape">
                <label
                  data-field-slot="label"
                  for="tb-corner-shape"
                  style="
                    --display: flex;
                    --items: center;
                    --justify: space-between;
                  "
                >
                  <span>Corner shape</span>
                  <output
                    class="fieldnotes__num"
                    for="tb-corner-shape"
                    style="--text: var(--color-muted-foreground)"
                  >
                    {defaults.cornerShape}
                  </output>
                </label>
                <input
                  id="tb-corner-shape"
                  name="corner-shape"
                  type="range"
                  min="-2"
                  max="4"
                  step="0.1"
                  value={defaults.cornerShape}
                  data-default={defaults.cornerShape}
                  data-theme-number="corner-shape"
                />
                <div data-field-slot="description">
                  <span data-field-slot="hint"
                    >1 is round and higher is squarer. 0 is a bevel, and below 0
                    the corners scoop in.</span
                  >
                </div>
              </div>
            </div>
          </details>
          <details
            open
            style="
              --py: 3;
              --border-style: dotted;
              --border-t: 1;
            "
          >
            <summary
              style="
                --px: 5;
                --font-weight: strong;
              "
            >
              Shadows
              <ChevronDown data-accordion-slot="marker" aria-hidden="true" />
            </summary>
            <div
              style="
                --display: grid;
                --px: 5;
                --py: 3;
                --gap: 3;
              "
            >
              <div data-ui="field">
                <label data-field-slot="label" for="tb-shadow-color"
                  >Shadow color</label
                >
                <label data-ui="input-group">
                  <input
                    data-ui="input"
                    id="tb-shadow-color"
                    name="shadow-color"
                    value={defaults.shadowColor}
                    data-default={defaults.shadowColor}
                    spellcheck="false"
                    autocomplete="off"
                    pattern="#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})"
                    data-theme-token="--color-shadow"
                  />
                  <span data-input-group-slot="addon">
                    <input
                      type="color"
                      value={defaults.shadowColor}
                      aria-label="Shadow color picker"
                      class="theme-builder__swatch"
                      data-theme-pick-for="tb-shadow-color"
                    />
                  </span>
                </label>
                <div data-field-slot="description">
                  <span data-field-slot="hint"
                    >Tints every shadow. Each layer keeps its own opacity.</span
                  >
                </div>
              </div>
              <div data-ui="field">
                <label
                  data-field-slot="label"
                  for="tb-elevation"
                  style="
                    --display: flex;
                    --items: center;
                    --justify: space-between;
                  "
                >
                  <span>Card elevation</span>
                  <output
                    class="fieldnotes__num"
                    for="tb-elevation"
                    style="--text: var(--color-muted-foreground)"
                  >
                    1.5
                  </output>
                </label>
                <input
                  id="tb-elevation"
                  name="card-elevation"
                  type="range"
                  min="0"
                  max="8"
                  step="0.5"
                  value="1.5"
                  data-fieldnotes-elevation
                />
                <div data-field-slot="description">
                  <span data-field-slot="hint"
                    >Preview only: not part of the copied theme.</span
                  >
                </div>
              </div>

              <div data-ui="field">
                <label
                  data-field-slot="label"
                  for="tb-shadow"
                  style="
                    --display: flex;
                    --items: center;
                    --justify: space-between;
                  "
                >
                  <span>Shadow angle</span>
                  <output
                    class="fieldnotes__num"
                    for="tb-shadow"
                    style="--text: var(--color-muted-foreground)"
                  >
                    {defaults.shadow}°
                  </output>
                </label>
                <input
                  id="tb-shadow"
                  name="shadow-angle"
                  type="range"
                  min="0"
                  max="360"
                  step="15"
                  value={defaults.shadow}
                  data-default={defaults.shadow}
                  data-theme-number="shadow"
                />
                <div data-field-slot="description">
                  <span data-field-slot="hint"
                    >0° casts down; the light turns clockwise from there.</span
                  >
                </div>
              </div>

              {
                SHADOW_KNOBS.map(({ key, label, hint }) => (
                  <div data-ui="field">
                    <label
                      data-field-slot="label"
                      for={`tb-shadow-${key}`}
                      style="
                        --display: flex;
                        --items: center;
                        --justify: space-between;
                      "
                    >
                      <span>{label}</span>
                      <output
                        class="fieldnotes__num"
                        for={`tb-shadow-${key}`}
                        style="--text: var(--color-muted-foreground)"
                      >
                        {defaults.shadowKnob}×
                      </output>
                    </label>
                    <input
                      id={`tb-shadow-${key}`}
                      name={`shadow-${key}`}
                      type="range"
                      min="0"
                      max="3"
                      step="0.1"
                      value={defaults.shadowKnob}
                      data-default={defaults.shadowKnob}
                      data-theme-number={`shadow-${key}`}
                    />
                    <div data-field-slot="description">
                      <span data-field-slot="hint">{hint}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </details>
        </ui-accordion>

        <section
          style="
            --display: grid;
            --position: sticky;
            --p: 5;
            --gap: 2;
            --bottom: 0;
            --mt: auto;
            --bg: var(--color-card);
            --border-style: dotted;
            --border-t: 1;
          "
        >
          <button
            data-ui="button"
            data-button-variant="muted"
            type="button"
            data-theme-copy
            disabled
          >
            <span
              data-copy-idle
              style="
                --display: inline-flex;
                --items: center;
                --gap: 2;
              "
            >
              <Copy size={16} aria-hidden="true" /> Copy CSS
            </span>
            <span
              data-copy-done
              hidden
              style="
                --display: inline-flex;
                --items: center;
                --gap: 2;
              "
            >
              <Check size={16} aria-hidden="true" /> Copied
            </span>
          </button>

          <button
            data-ui="button"
            data-button-variant="muted"
            type="button"
            command="show-modal"
            commandfor="tb-css"
          >
            <Code size={16} aria-hidden="true" /> Preview CSS
          </button>
          <button
            data-ui="button"
            data-button-variant="warning"
            type="reset"
            data-theme-reset
            disabled
          >
            <RotateCcw size={16} aria-hidden="true" /> Reset all
          </button>

          <dialog
            id="tb-css"
            data-ui="dialog"
            closedby="any"
            aria-labelledby="tb-css-title"
          >
            <div data-dialog-slot="content">
              <header data-dialog-slot="header" style="--pr: 12">
                <h2 id="tb-css-title" data-ui="text-md">Theme CSS</h2>
                <p
                  data-ui="text-sm"
                  style="--text: var(--color-muted-foreground)"
                >
                  Only the variables you changed. Paste it into your stylesheet.
                </p>
              </header>
              <div data-dialog-slot="body">
                <pre
                  data-ui="text-xs"
                  style="
                    --p: 3;
                    --font-family: var(--font-family-mono);
                    --bg: var(--color-muted);
                    --radius: 2.5;
                    --overflow: auto;
                  "><code class='theme-builder__css' data-theme-css>/* No changes yet */</code></pre>
              </div>
              <footer data-dialog-slot="footer">
                <button
                  data-ui="button"
                  type="button"
                  commandfor="tb-css"
                  command="close">Close</button
                >
                <button
                  data-ui="button"
                  data-button-variant="primary"
                  type="button"
                  data-theme-copy-proxy
                >
                  <Copy size={16} aria-hidden="true" /> Copy
                </button>
              </footer>
            </div>
            <button
              data-ui="button"
              data-dialog-slot="close"
              data-button-size="icon"
              data-button-variant="ghost"
              type="button"
              commandfor="tb-css"
              command="close"
              aria-label="Close"
            >
              <X aria-hidden="true" />
            </button>
          </dialog>
        </section>
      </form>
    </div>
    <style is:inline data-theme-output></style>
  </theme-builder>

  <!-- --shadow-tint at the kit's default makes the kit re-declare its shadow tokens here, so they follow the preview's spacing and light angle. The body family and text color are applied on <html> and inherited resolved, so the wrapper reads those tokens again, and paints the theme's background. -->
  <section
    style="
      --min-h: 100%;
      --bg: var(--color-background);
      --border-l: 0;
      --border-l--lg: 1;
      --border-t: 1;
      --radius-t--lg: var(--ui-card-radius);
      --radius-r: 0;
      --overflow: clip;
    "
  >
    <div
      class="fieldnotes__preview"
      data-ui="scroll-fade"
      data-scroll-fade-axis="x"
      style="
        --px--lg: 5;
        --pt: 6;
        --pl: 5;
        --pr: 0;
        --min-h: 100%;
        --font-family: var(--font-family-body);
        --text: var(--color-foreground);
        --bg: var(--color-background);
        --shadow-tint: var(--color-shadow);
        --overflow-x: auto;
      "
    >
      <!-- Packed like a masonry by <fieldnotes-demo>: it measures each card into a row span.
           Columns floor at min-content (and each card overrides the card's minmax(0, 1fr)
           track) so a large spacing widens the columns instead of clipping the cards. -->
      <div
        data-fieldnotes-grid
        style="
          --display: grid;
          --grid-flow: dense;
          --items: start;
          --template-cols: repeat(4, minmax(min-content, 1fr));
          --pr: 5;
          --gap-x: 5;
          --gap-y: 0;
          --min-w: 84rem;
          --container-type: inline-size;
        "
      >
        <SightingForm toaster={TOASTER} />
        <LifeList />
        <SpeciesCard species={featured} />
        <AlertSettings />
        {rest.slice(0, 2).map((s) => <SpeciesCard species={s} />)}
        <SightingsTable />
        <Spotters />
        {rest.slice(2).map((s) => <SpeciesCard species={s} />)}
      </div>
    </div>
  </section>

  <ui-toaster id={TOASTER} popover="manual"></ui-toaster>
</fieldnotes-demo>
