---
/**
 * The theme builder: a grid of Fieldnotes cards (a birding app built from Zazz
 * primitives) and a theme form. On wide screens the form is a sticky column on
 * the left; on narrow ones it collapses to a bar at the bottom of the screen
 * with one button per form section, each opening the form in a sheet on that
 * section. Changes apply live to the cards only (the
 * `.fieldnotes__preview` wrapper), live in the URL as a `?preset=` share code
 * until reset (scripts/theme-builder.ts, lib/preset.ts), and
 * copy as a `:root { … }` block of the variables that changed. The card
 * elevation slider restyles the preview but is never part of the copied CSS.
 * Generate randomizes every control but the ones whose lock is pressed
 * (ThemeLock.astro); a section's summary holds a lock for all of its fields.
 *
 * Behavior lives in `<theme-builder>` (scripts/theme-builder.ts) and in
 * `<fieldnotes-demo>` / `<fieldnotes-sightings>` (scripts/fieldnotes.ts). The script at the end
 * of this file ships them only with pages that render the component; scripts/islands.ts loads the
 * same modules when the page is reached by a swap navigation instead. One more runs inline, right
 * after the card grid: it packs the grid during parse (scripts/fieldnotes-pack.ts), so the cards
 * paint packed instead of waiting, hidden, for those modules.
 */
import languageData from '@zazz-ui/core/editor/zazz.language-data.json';
import Icon from './Icon.astro';
import { CORNER_SHAPE } from '../lib/corner-shape.ts';
import { iconMask } from '../lib/icons.ts';
import { inlineScript } from '../lib/inline-script.ts';
import { PRESET_PARAM } from '../lib/preset.ts';
import { declaredProperties, stageScope } from '../lib/stage-scope.ts';
import siteLook from '../styles/site-look.css?raw';
import packSource from '../scripts/fieldnotes-pack.ts?raw';
import { species } from '../lib/fieldnotes.ts';
import {
  FONT_CATEGORIES,
  LOCAL_FONTS,
  SCALE_STEPS,
  pickGoogleFonts,
  type FontCategory,
  type FontOption,
  type GoogleFontItem,
} from '../lib/fonts.ts';
import {
  backgroundDeclaration,
  BACKGROUNDS,
  DEFAULT_BACKGROUND,
  STOPS,
  toHex,
} from '../lib/palette.ts';
import AlertSettings from './fieldnotes/AlertSettings.astro';
import Conditions from './fieldnotes/Conditions.astro';
import FieldBadges from './fieldnotes/FieldBadges.astro';
import Journal from './fieldnotes/Journal.astro';
import LifeList from './fieldnotes/LifeList.astro';
import NextTrip from './fieldnotes/NextTrip.astro';
import PackList from './fieldnotes/PackList.astro';
import Plates from './fieldnotes/Plates.astro';
import ReviewStatus from './fieldnotes/ReviewStatus.astro';
import SightingForm from './fieldnotes/SightingForm.astro';
import SightingsTable from './fieldnotes/SightingsTable.astro';
import SpeciesCard from './fieldnotes/SpeciesCard.astro';
import Spotters from './fieldnotes/Spotters.astro';
import ThemeLock from './ThemeLock.astro';
import VerifyCode from './fieldnotes/VerifyCode.astro';

const TOASTER = 'fieldnotes-toaster';

const GENERATE_BUTTON_LABEL = 'Generate a new theme';
/** The Generate button's icon, as the mask its rainbow shows through (site-look.css). */
const generateIcon = iconMask('burst');

/**
 * The controls' starting values, copied from the kit's tokens in
 * `_variables.css`; a control at its starting value writes nothing. The kit's
 * `--spacing` is fluid (0.225rem to 0.25rem), so 0.25 is the top of that range
 * and the page stays fluid until the value changes.
 */
const defaults = {
  // --color-primary is --color-primary-950 in light mode: oklch(0.145 0 0).
  primary: toHex({ l: 0.145, c: 0, h: 0 }),
  // --color-secondary is --color-secondary-950 in light mode: oklch(13% 0.028 261.692).
  secondary: toHex({ l: 0.13, c: 0.028, h: 261.692 }),
  // --color-tertiary is --color-tertiary-950 in light mode: oklch(0.147 0.004 49.3).
  tertiary: toHex({ l: 0.147, c: 0.004, h: 49.3 }),
  // --color-neutral-500: oklch(0.629 0.012 286.12).
  neutral: toHex({ l: 0.629, c: 0.012, h: 286.12 }),
  spacing: 0.25,
  radius: 1,
  shadow: 0,
  // --radius-corner-shape: superellipse(1.3).
  cornerShape: 1.3,
  // --color-shadow: black.
  shadowColor: '#000000',
  // --default-shadow-intensity / -blur / -distance.
  shadowKnob: 1,
  // --typeset-scale-min / --typeset-scale-max.
  scaleMin: 1.125,
  scaleMax: 1.25,
};

/**
 * The Google families on offer: the curated seven of each category
 * (`CURATED_FONTS`), checked against the API once at build with the
 * server-side key, which also says which weights each family ships. A fork
 * without the key, or an API that fails, gets the local stacks only. The key
 * is never logged and never reaches the page: only names and weights do.
 */
async function googleFonts(): Promise<FontOption[]> {
  const key = import.meta.env.GOOGLE_FONTS_API_KEY;
  if (!key) return [];
  try {
    const url = new URL('https://www.googleapis.com/webfonts/v1/webfonts');
    url.searchParams.set('key', key);
    // The key is restricted to the site's referrers, so the build introduces
    // itself as the site (there is no browser here to do it).
    const response = await fetch(url, {
      headers: { Referer: Astro.site?.href ?? '' },
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const data = (await response.json()) as { items?: GoogleFontItem[] };
    return pickGoogleFonts(data.items ?? []);
  } catch (error) {
    console.warn(
      `ThemeBuilder: Google Fonts unavailable (${error instanceof Error ? error.message : 'error'}); offering local fonts only.`,
    );
    return [];
  }
}

const google = await googleFonts();

/** The combobox groups: the Google families by category, or the local stacks when there are none. */
const CATEGORY_LABEL: Record<FontCategory, string> = {
  'sans-serif': 'Sans serif',
  serif: 'Serif',
  monospace: 'Monospace',
};
const fontGroups =
  google.length > 0 ?
    FONT_CATEGORIES.map((category) => ({
      label: CATEGORY_LABEL[category],
      fonts: google.filter((f) => f.category === category),
    })).filter((group) => group.fonts.length > 0)
  : [{ label: 'System', fonts: LOCAL_FONTS }];

/** The font controls: one family for headings, one for body text. */
const fontRoles = [
  { role: 'heading', label: 'Heading font', other: 'body font' },
  { role: 'body', label: 'Body font', other: 'heading font' },
] as const;
const fontDefault = 'Default (system sans)';

const scales = [
  {
    name: 'scale-min',
    label: 'Scale at narrow widths',
    value: defaults.scaleMin,
  },
  {
    name: 'scale-max',
    label: 'Scale at wide widths',
    value: defaults.scaleMax,
  },
] as const;

const palettes = [
  {
    name: 'neutral',
    label: 'Neutral',
    hint: 'Surfaces, borders, and body text.',
  },
  {
    name: 'primary',
    label: 'Primary',
    hint: 'Buttons, links, focus rings, and selection.',
  },
  {
    name: 'secondary',
    label: 'Secondary',
    hint: 'Secondary buttons, badges, and toggles.',
  },
  {
    name: 'tertiary',
    label: 'Tertiary',
    hint: 'Tertiary buttons, badges, and toggles.',
  },
] as const;

/** The background selects: one per scheme, each limited to its end of the neutral scale. */
const backgrounds = [
  { scheme: 'light', label: 'Light background' },
  { scheme: 'dark', label: 'Dark background' },
] as const;
const backgroundLabel = (pick: string) =>
  pick === 'white' ? 'White'
  : pick === 'black' ? 'Black'
  : `Neutral ${pick}`;
const backgroundSwatch = (pick: string) =>
  pick === 'white' || pick === 'black' ?
    `var(--color-${pick})`
  : `var(--color-neutral-${pick})`;

const [featured, ...rest] = species;

/** The collapsed bar's buttons (narrow screens): one per form section, opening the sheet on it. */
const sections = [
  { id: 'palette', label: 'Palette', icon: 'palette' },
  { id: 'typeset', label: 'Typeset', icon: 'font' },
  { id: 'styles', label: 'Styles', icon: 'sliders' },
  { id: 'effects', label: 'Effects', icon: 'layer-group' },
] as const;

/** The shadow multipliers: one slider each, 0 to 3 times the kit's shadow. */
const SHADOW_KNOBS = [
  {
    key: 'intensity',
    label: 'Shadow intensity',
    hint: 'Darker above 1, lighter below.',
  },
  { key: 'blur', label: 'Shadow blur', hint: 'Softer above 1, crisper below.' },
  {
    key: 'distance',
    label: 'Shadow distance',
    hint: 'How far the shadow falls from the surface.',
  },
];

/**
 * The kit resolves its tokens on `:root`, so `--space-md` is a length by the
 * time a card inherits it and a `--spacing` set on the preview alone would
 * change nothing. Re-declaring every derived token and hook (any whose value
 * reads a `var()`) on the preview wrapper makes them recompute there from the
 * live theme, while the rest of the page keeps the site's values. The shadow
 * tokens are re-declared by the kit itself wherever `--shadow-tint` is set, so
 * the wrapper carries a no-op tint instead (see its `style`). Re-declaring
 * `--ui-field-font-size` also drops the kit's iOS-only 16px floor (fields.css),
 * so the preview restores it after the rest, or a focused field zooms the page.
 *
 * The site's own look (styles/site-look.css) sets plain values on `:root`, which
 * the preview would inherit as its starting theme: `lookReset` puts the kit's
 * defaults back first, so the preview starts from the kit as shipped. The live
 * theme is unlayered and still wins.
 */
const kitDefaults = { ...languageData.tokens, ...languageData.hooks };
const lookReset = stageScope(siteLook, kitDefaults, '.fieldnotes__preview');
/**
 * The panel keeps the site's look, but its palette strips and background
 * swatches show the theme being built, painted from the kit's color tokens
 * until a palette changes (scripts/theme-builder.ts). They take the kit's
 * colors back, and only the colors: their corners stay the site's.
 */
const swatchReset = stageScope(
  declaredProperties(siteLook).filter((name) => name.startsWith('--color-')),
  kitDefaults,
  '[data-theme-strip], [data-theme-bg-swatch]',
);
const derived = Object.entries({
  ...languageData.tokens,
  ...languageData.hooks,
})
  .filter(([, { value }]) => value.includes('var('))
  .map(([name, { value }]) => `${name}: ${value};`)
  .join(' ');
const previewScope = `${lookReset}
${swatchReset}
@layer zazz.variables {
  .fieldnotes__preview { ${derived} ${backgroundDeclaration(DEFAULT_BACKGROUND.light, DEFAULT_BACKGROUND.dark)}; }
  @supports (-webkit-touch-callout: none) {
    .fieldnotes__preview { --ui-field-font-size: max(16px, var(--font-size-sm)); }
  }
}`;

/**
 * Packs the card grid (the script's previous sibling) as soon as it has parsed.
 * The cards show at once unless a `?preset=` theme is about to be restored,
 * which `<fieldnotes-demo>` shows once applied. Marked shown before measuring:
 * the hidden style never paints, so its fade never starts.
 */
const packScript = await inlineScript(
  packSource,
  'fieldnotes-pack.ts',
  `const script = document.currentScript;
  if (!new URLSearchParams(location.search).has(${JSON.stringify(PRESET_PARAM)})) {
    script.closest('fieldnotes-demo')?.setAttribute('data-fieldnotes-packed', '');
  }
  packGrid(script.previousElementSibling);`,
);
---

<style is:inline set:html={previewScope}></style>

<fieldnotes-demo
  class='fieldnotes'
  style='
    --display: grid;
    --position: relative;
    --items: start;
    --justify: center;
    --template-cols: minmax(0, 1fr);
    --template-cols--lg: 36ch minmax(0, 1fr);
    --w: 100%;
  '
>
  <!--
    Narrow screens: a bar stuck to the bottom with one button per form section
    and the actions; the form itself moves into the sheet (the dialog) and back as the
    width changes (scripts/theme-builder.ts). Wide screens: the form inline, stuck below the header.
  -->
  <theme-builder
    style='
      --position: sticky;
      --order: 0;
      --order--lg: 0;
      --p: 0;
      --px--lg: 0;
      --py--lg: 0;
      --top: calc(var(--ui-header-height, 0rem));
      --bottom: auto;
      --h: auto;
      --h--lg: calc(100dvb - var(--ui-header-height, 0rem));
      --border-x: 0;
      --z: 30;
    '
  >
    <!-- MOBILE THEME BUILDER BAR -->
    <ui-card
      data-card-variant='outline'
      data-theme-bar
      style='
        --display: grid;
        --display--lg: none;
        --p: 3;
        --gap: 2;
        --text: var(--color-card-foreground);
        --bg: var(--color-card);
        --border-x: 0;
        --elevation: 0;
        --elevation--stuck: 4;
        --radius: 0;
        --radius--lg: 6;
        --pointer-events: auto;
      '
    >
    <div
        style='
          --display: flex;
          --position: relative;
          --gap: 2;
          --z: 10;
        '
      >
         <button
              class="theme-builder__generate-button"
              data-ui='button'
              type='button'
              aria-label='Randomize the theme'
              data-theme-randomize
              style='
                --flex: 1;
                --h: auto;
                --h--lg: calc(var(--ui-button-min-h) + var(--spacing) * 2);
              '
            >
              <span class='theme-builder__generate-icon' style={`--_icon: ${generateIcon}`} aria-hidden='true'></span>
              <span class='theme-builder__generate-label'>{GENERATE_BUTTON_LABEL}</span>
            </button>
        <button
          data-ui='button'
          data-button-variant='warning'
          data-button-size='icon'
          type='button'
          data-theme-reset-proxy
        >
          <Icon name='arrow-rotate-left' size={16} aria-hidden='true' />
          <span style="--sr: only">Reset the theme</span>
        </button>
      </div>
      <div
        style='
          --display: grid;
          --position: relative;
          --grid-cols: 3;
          --gap: 2;
          --z: 10;
        '
      >
        <button
          data-ui='button'
          data-button-variant='muted'
          type='button'
          data-theme-copy-proxy
          disabled
        >
          <span
            data-copy-idle
            style='
              --display: inline-flex;
              --items: center;
              --gap: 2;
            '
          >
            <Icon name='clone' size={16} aria-hidden='true' /> Copy
          </span>
          <span
            data-copy-done
            hidden
            style='
              --display: inline-flex;
              --items: center;
              --gap: 2;
            '
          >
            <Icon name='check' size={16} aria-hidden='true' /> Copied
          </span>
        </button>
        <button
          data-ui='button'
          data-button-variant='muted'
          type='button'
          command='show-modal'
          commandfor='tb-css'
        >
          <Icon name='code' size={16} aria-hidden='true' /> Preview
        </button>
        <button
          data-ui='button'
          data-button-variant='muted'
          type='button'
          data-theme-share
        >
          <span
            data-share-idle
            style='
              --display: inline-flex;
              --items: center;
              --gap: 2;
            '
          >
            <Icon name='arrow-up-from-bracket' size={16} aria-hidden='true' /> Share
          </span>
          <span
            data-share-done
            hidden
            style='
              --display: inline-flex;
              --items: center;
              --gap: 2;
            '
          >
            <Icon name='check' size={16} aria-hidden='true' /> Copied
          </span>
        </button>
      </div>
      <div
        style='
          --display: grid;
          --position: relative;
          --grid-cols: 4;
          --gap: 2;
          --z: 20;
        '
      >
        {
          sections.map(({ id, label, icon }) => (
            <button
              type='button'
              data-ui='button'
              data-button-variant='outline'
              command='show-modal'
              commandfor='tb-sheet'
              data-theme-section-open={id}
              style='
                --display: grid;
                --place-items: center;
                --px: 1;
                --py: 2;
                --gap: 1;
                --h: auto;
                --bg: var(--color-faded);
              '
            >
              <Icon name={icon} size={16} aria-hidden='true' />
              <span data-ui='text-xs'>{label}</span>
            </button>
          ))
        }
      </div>

    </ui-card>

    <dialog
      id='tb-sheet'
      data-ui='drawer'
      data-theme='dark'
      closedby='any'
      aria-labelledby='tb-sheet-title'
    >
      <div data-drawer-slot='handle'></div>
      <!-- The drawer shows one section at a time, titled with its name (set by
           scripts/theme-builder.ts). Its own header row: the form's header
           (title + Generate) is wide-screen only, and Generate lives in the bar. Copy and Close sit in
           the row rather than in the absolute close slot, so the form's sticky
           header can never cover them. -->
      <div data-drawer-slot='content'>
        <header
          data-drawer-slot='header'
          style='
            --display: grid;
            --place-items: center stretch;
            --template-cols: 1fr auto;
            --pb: 3;
            --gap: 2;
            --border-b: 1;
          '
        >
          <h2
            id='tb-sheet-title'
            data-ui='text-md'
            data-theme-sheet-title
            style='--text-align: start'
          >
            Theme builder
          </h2>

        </header>
        <div data-drawer-slot='body' data-theme-sheet></div>
      </div>
    </dialog>

    <!-- Outside the form: on narrow screens the form sits in the closed sheet,
         where a dialog inside it could not be shown. -->
    <dialog
      id='tb-css'
      data-ui='dialog'
      closedby='any'
      aria-labelledby='tb-css-title'
    >
      <div data-dialog-slot='content'>
        <header data-dialog-slot='header' style='--pr: 12'>
          <h2 id='tb-css-title' data-ui='text-md'>Theme CSS</h2>
          <p
            data-ui='text-sm'
            style='--text: var(--color-muted-foreground)'
          >
            Only the variables you changed. Paste it into your stylesheet.
          </p>
        </header>
        <div data-dialog-slot='body'>
          <pre
            data-ui='text-xs'
            style='
              --p: 3;
              --font-family: var(--font-family-mono);
              --bg: var(--color-muted);
              --radius: 2.5;
              --overflow: auto;
            '><code class='theme-builder__css' data-theme-css>/* No changes yet */</code></pre>
        </div>
        <footer data-dialog-slot='footer'>
          <button
            data-ui='button'
            type='button'
            commandfor='tb-css'
            command='close'>Close</button
          >
          <button
            data-ui='button'
            data-button-variant='primary'
            type='button'
            data-theme-copy-proxy
          >
            <Icon name='clone' size={16} aria-hidden='true' /> Copy
          </button>
        </footer>
      </div>
      <ui-tooltip>
        <button
          data-ui='button'
          data-dialog-slot='close'
          data-button-size='icon'
          data-button-variant='ghost'
          type='button'
          commandfor='tb-css'
          command='close'
          aria-label='Close'
          interestfor='tb-css-close-tip'
        >
          <Icon name='xmark' aria-hidden='true' />
        </button>
        <div
          data-tooltip-slot='content'
          id='tb-css-close-tip'
          popover='hint'
        >
          Close
          <span data-tooltip-slot='arrow' aria-hidden='true'></span>
        </div>
      </ui-tooltip>
    </dialog>

    <!-- DESKTOP THEME BUILDER PANEL -->
    <div
      data-theme-panel
      style='
        --display: none;
        --display--lg: flex-col;
        --h: 100%;
        --border-r: 1;
        --overflow: clip;
      '
    >
      <form
        class='theme-builder__form'
        aria-labelledby='tb-title'
        style='
          --display: flex-col;
          --justify: start;
          --gap: 0;
          --h: 100%;
          --text: var(--color-card-foreground);
          --bg: var(--color-card);
          --overflow-y: auto;
        '
      >
        <header
          style='
            --display: none;
            --display--lg: flex-col;
            --position: sticky;
            --px: 5;
            --pt: 5;
            --pb: 3;
            --gap: 3;
            --top: 0;
            --bg: oklch(from var(--color-card) l c h / 0.95);
            --border-b: 1;
            --backdrop-filter: blur(6px);
            --z: 10;
          '
        >
          <div
            style='
              --display: flex;
              --items: center;
              --justify: space-between;
              --gap: 2;
            '
          >
            <h2 id='tb-title' data-ui='text-lg' style="--sr: only">Theme builder</h2>
            <button
              class="theme-builder__generate-button"
              data-ui='button'
              type='button'
              aria-label='Randomize the theme'
              data-theme-randomize
              style='
                --w: 100%;
                --h: calc(var(--ui-button-min-h) + var(--spacing) * 2);
              '
            >
              <span class='theme-builder__generate-icon' style={`--_icon: ${generateIcon}`} aria-hidden='true'></span>
              <span class='theme-builder__generate-label'>{GENERATE_BUTTON_LABEL}</span>
            </button>
          </div>
          <!-- The theme's actions, under Generate. Copy and Reset here are the real
               controls; the bar's are proxies for them (scripts/theme-builder.ts). -->
          <div
            style='
              --display: grid;
              --position: relative;
              --template-cols: 1fr 1fr 1fr auto;
              --gap: 2;
              --z: 10;
            '
          >
            <button
              data-ui='button'
              type='button'
              data-theme-copy
              disabled
            >
              <span
                data-copy-idle
                style='
                  --display: inline-flex;
                  --items: center;
                  --gap: 2;
                '
              >
                <Icon name='clone' size={16} aria-hidden='true' /> Copy
              </span>
              <span
                data-copy-done
                hidden
                style='
                  --display: inline-flex;
                  --items: center;
                  --gap: 2;
                '
              >
                <Icon name='check' size={16} aria-hidden='true' /> Copied
              </span>
            </button>
            <button
              data-ui='button'
              type='button'
              command='show-modal'
              commandfor='tb-css'
            >
              <Icon name='code' size={16} aria-hidden='true' /> Preview
            </button>
            <button
              data-ui='button'
              type='button'
              data-theme-share
            >
              <span
                data-share-idle
                style='
                  --display: inline-flex;
                  --items: center;
                  --gap: 2;
                '
              >
                <Icon name='arrow-up-from-bracket' size={16} aria-hidden='true' /> Share
              </span>
              <span
                data-share-done
                hidden
                style='
                  --display: inline-flex;
                  --items: center;
                  --gap: 2;
                '
              >
                <Icon name='check' size={16} aria-hidden='true' /> Copied
              </span>
            </button>
            <button
              data-ui='button'
              data-button-variant='warning'
              data-button-size='icon'
              type='reset'
              data-theme-reset
              disabled
            >
              <Icon name='arrow-rotate-left' size={16} aria-hidden='true' /> <span style='--sr: only'>Reset theme</span>
            </button>
          </div>
        </header>

        <!-- Each section is a disclosure; the bar's section buttons open the sheet on one (data-theme-section). -->
        <ui-accordion
          style='
            --justify: start;
            --flex: 0 0 auto;
            --gap: 0;
          '
        >
          <details
            open
            data-theme-section='palette'
            class='theme-builder__section'
            style='--border-style: dashed'
          >
            <summary
              data-ui='text-eyebrow'
              style='
                --px: 5;
                --py: 3;
                --text: var(--color-muted-foreground);
                --text--hover: var(--color-foreground);
              '
            >
              Palette
              <ThemeLock
                section='palette'
                label='all palette fields'
                size='icon-sm'
              />
              <Icon name='angle-down' data-accordion-slot='marker' aria-hidden='true' />
            </summary>
            <div
              style='
                --display: grid;
