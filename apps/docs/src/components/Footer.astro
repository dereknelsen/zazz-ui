---
import { links, nav, site } from "../site.config.ts";
import Logo from "./Logo.astro";
---

<footer style="
    --pt: 11;
    --border-t: 1;
  ">
  <ui-layout>
    <div
      style="
      --display: grid;
      --grid-cols: 1;
      --template-cols--md: auto 1fr 1fr;
      --items: start;
      --gap: 8;
      --gap--md: 16;
    "
    >
      <a
        href="/"
        aria-label="Zazz home"
        style="--display: flex; --items: center; --gap: 4"
      >
        <Logo size={40} variant="mark" />
      </a>

      <nav aria-label="Footer" style="--display: flex-col; --gap: 2">
        <h2
          id="navigation"
          data-ui="text-eyebrow"
          style="--text: var(--color-foreground);"
        >
          Navigation
        </h2>
        <ul style="--display: flex; --gap: 5; --flex-wrap: wrap">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} data-ui="text-sm text-link">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={links.github} data-ui="text-sm text-link" rel="noopener"
              >GitHub</a
            >
          </li>
        </ul>
      </nav>

      <section
        aria-labelledby="acknowledgements"
        data-ui="text-sm"
        style="
          --display: flex-col;
          --gap: 2;
        "
      >
        <h2 id="acknowledgements" data-ui="text-eyebrow" style="--mb: 1.5">
          Acknowledgements
        </h2>
        <div
          style="
            --font-style: italic;
            --text-wrap: balance;
            --text: var(--color-muted-foreground); 
            --display: flex-col;
            --gap: 2;
          "
        >
          <p>
            Zazz is heavily inspired by tailwindcss, shadcn/ui, base-ui, and
            Emil Kowalski. Thank you for your incredible work.
          </p>
        </div>
      </section>
    </div>
  </ui-layout>

  <ui-layout>
    <section
      data-ui="text-xs"
      style="
        --band: layout-bleed;
        --display: flex;
        --items: center;
        --justify: center;
        --py: 6;
        --mt: 6;
        --gap: 2;
        --text: var(--color-muted-foreground);
      "
    >
      <p>
        Built and maintained by Derek Nelsen. Licensed under the MIT License.
        Source code available on <a
          data-ui="text-link"
          href={links.github}
          rel="noopener">GitHub</a
        >.
      </p>
    </section>
  </ui-layout>
</footer>
