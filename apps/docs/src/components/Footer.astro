---
import { links, nav, site } from "../site.config.ts";
import Logo from "./Logo.astro";
---

<footer
  style="
    --pt: 11;
    --bg: var(--color-background);
    --border-t: 1;
  "
>
  <ui-layout>
    <div
      style="
        --display: grid;
        --place-items: center;
        --place-items--sm: start;
        --template-cols: 1fr;
        --template-cols--md: auto 1fr 2fr;
        --gap-x: 8;
        --gap-y: 8;
        --gap-y--md: 16;
      "
    >
      <a href="/" aria-label="Zazz home">
        <Logo size={40} />
      </a>

      <nav
        aria-label="Footer"
        style="
          --display: flex-col;
          --justify: center;
          --justify--sm: start;
          --gap: 2;
          --text-align: center;
          --text-align--sm: left;
        "
      >
        <h2
          id="navigation"
          data-font="eyebrow"
          style="--text: var(--color-foreground)"
        >
          Navigation
        </h2>
        <ul
          style="
            --display: flex;
            --flex-wrap: balance;
            --justify: center;
            --justify--sm: start;
            --gap: 5;
          "
        >
          {nav.map((item) => (
            <li>
              <a href={item.href} data-ui="link" data-font="sm">
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href={links.github} data-ui="link" data-font="sm" rel="noopener">
              GitHub
            </a>
          </li>
        </ul>
      </nav>

      <section
        aria-labelledby="acknowledgements"
        data-font="sm"
        style="
          --display: flex-col;
          --justify: center;
          --justify--sm: start;
          --gap: 2;
          --text-align: center;
          --text-align--sm: left;
        "
      >
        <h2 id="acknowledgements" data-font="eyebrow" style="--mb: 1.5">
          Acknowledgements
        </h2>
        <div
          style="
            --display: flex-col;
            --gap: 2;
            --font-style: italic;
            --text-wrap: balance;
            --text: var(--color-muted-foreground);
          "
        >
          <p>
            Zazz is heavily inspired by{" "}
            <a
              data-ui="link"
              href="https://tailwindcss.com/"
              target="_blank"
              rel="noopener"
            >
              Tailwind
            </a>
            ,{" "}
            <a
              data-ui="link"
              href="https://ui.shadcn.com/"
              target="_blank"
              rel="noopener"
            >
              Shadcn
            </a>
            ,{" "}
            <a
              data-ui="link"
              href="https://base-ui.org/"
              target="_blank"
              rel="noopener"
            >
              Base UI
            </a>
            ,{" "}
            <a
              data-ui="link"
              href="https://www.kevinpowell.co/"
              target="_blank"
              rel="noopener"
            >
              Kevin Powell
            </a>
            ,{" "}
            <a
              data-ui="link"
              href="https://www.joshwcomeau.com/"
              target="_blank"
              rel="noopener"
            >
              Josh Comeau
            </a>{" "}
            and many others. Thank you all for your incredible work, support,
            and inspiration.
          </p>
        </div>
      </section>

      <section
        data-font="xs"
        style="
          --display: flex-col;
          --items: center;
          --justify: center;
          --col-start: 1;
          --col-end: -1;
          --pt: 6;
          --pt--sm: 0;
          --pb: 6;
          --gap: 2;
          --w: 100%;
          --text-align: center;
          --text: var(--color-muted-foreground);
          --border-t: 1;
          --border-t--sm: 0;
        "
      >
        <p style="--text-wrap: balance">
          Built and maintained by Derek Nelsen. Licensed under the MIT License.
          Source code available on{" "}
          <a data-ui="link" href={links.github} rel="noopener">
            GitHub
          </a>
          .
        </p>
      </section>
    </div>
  </ui-layout>
</footer>
