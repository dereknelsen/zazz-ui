---
/**
 * The Zazz logo mark as inline SVG. `currentColor` fills, so it follows the
 * text color of wherever it sits.
 */
interface Props {
  /** Width and height in px (the mark is square). */
  size?: number;
  title?: string;
  style?: string;
}

const { size = 30, title = "Zazz", style } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 30 30"
  width={size}
  height={size}
  fill="none"
  role="img"
  aria-label={title}
  style={style as string}
>
  <rect width="30" height="30" fill="none"></rect>
  <path fill="currentColor" d="M30 12 12 30H0L21 9H2V4h5.5V0H21v9l9-9z"></path>
  <path fill="currentColor" d="M30 30h-9v-9h9z"></path>
</svg>
