---
/**
 * The Zazz logo mark as inline SVG. `currentColor` fills, so it follows the
 * text color of wherever it sits.
 */
interface Props {
  /** Width and height in px (the mark is square). */
  size?: number;
  title?: string;
  style?: string;
}

const { size = 30, title = "Zazz", style } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 30 30"
  width={size}
  height={size}
  fill="none"
  role="img"
  aria-label={title}
  style={style as string}
>
  <path fill="currentColor" d="M30 12.4 12.4 30H0L30 0z"></path>
  <path fill="currentColor" d="M30 21.2V30h-8.8v-8.8zM21.2 8.8H2.8V3.6h6.3V0h12.1z"></path>
</svg>
