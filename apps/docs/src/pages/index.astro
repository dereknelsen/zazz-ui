---
import HeroScene from "../components/HeroScene.astro";
import ThemeBuilder from "../components/ThemeBuilder.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { softwareLd } from "../lib/jsonld.ts";
import { kitVersion } from "../lib/kit.ts";
import { site } from "../site.config.ts";
import { MoveRight } from "@lucide/astro";
---

<BaseLayout title={site.name} jsonLd={[softwareLd(kitVersion())]}>
  <main id="main" style="
      --display: grid;
      --position: relative;
    ">
    <section
      data-ui="layout"
      data-layout-size="bleed"
      style="--min-h: calc(100svh - var(--ui-header-height))"
    >
      <div
        style="
          --display: subgrid-col;
          --position: relative;
          --h: auto;
          --h--lg: 112;
          --max-h: 100%;
          --max-h--lg: 70svh;
          --overflow: clip;
        "
      >
        <figure
          style="
            --display: grid;
            --position: absolute;
            --band: layout-bleed;
            --inset: 0;
            --z: 10;
          "
        >
          <HeroScene />
        </figure>
        <div
          style="
            --display: grid;
            --place-items: center;
            --place-content: center;
            --self: center;
            --self--lg: start;
            --band: layout-xl;
            --py: 11;
            --py--lg: 0;
            --top: var(--ui-header-height);
            --mb: 0;
            --h: auto;
            --h--lg: 100%;
            --z: 30;
          "
        >
          <hgroup
            style="
              --display: grid;
              --place-items: center;
              --place-items--lg: start;
              --template-cols--lg: 1.2fr 1fr;
              --gap: 6;
              --gap--lg: 12;
              --text-align: center;
              --text-align--lg: start;
            "
          >
            <div
              style="
                --display: flex-col;
                --gap: 4;
                --text-align: center;
                --text-align--lg: start;
              "
            >
              <h1
                style="
                  --text: var(--color-muted-foreground);
                  --sr: only;
                "
              >
                {site.title}
              </h1>
              <p data-ui="text-h1" style="--text-wrap: balance">
                A design system <br />for the baseline web.
              </p>
            </div>
            <div
              style="
                --display: flex-col;
                --justify: center;
                --justify--lg: end;
                --pb: 1;
                --gap: 6;
                --h: 100%;
              "
            >
              <p data-ui="text-lg" style="--text-wrap: balance">
                Unified collection of web-native primitives, style utilities,
                and design tokens for no-build, low-build, and legacy projects.
              </p>
              <div
                style="
                  --display: flex;
                  --justify: center;
                  --justify--lg: start;
                  --gap: 2;
                "
              >
                <a
                  href="/docs/quick-start/"
                  data-ui="button"
                  data-button-variant="primary">Quick start</a
                >
                <a
                  href="/playground"
                  data-ui="button"
                  data-button-variant="muted" style="--backdrop-filter: brightness(1.5)">Code playground <MoveRight /></a
                >
              </div>
            </div>
          </hgroup>
        </div>
      </div>

      <div style="--band: layout-bleed">
        <ThemeBuilder />
      </div>
    </section>
  </main>
</BaseLayout>
