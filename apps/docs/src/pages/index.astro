---
import HeroScene from '../components/HeroScene.astro';
import ThemeBuilder from '../components/ThemeBuilder.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { softwareLd } from '../lib/jsonld.ts';
import { kitVersion } from '../lib/kit.ts';
import { SCENE_URL, SDK_URL } from '../lib/unicorn.ts';
import { site } from '../site.config.ts';
import Icon from '../components/Icon.astro';
---

<BaseLayout title={site.name} jsonLd={[softwareLd(kitVersion())]}>
  <Fragment slot='head'>
    <!-- The hero scene is in the first viewport: start the SDK and the scene
         now, not when <hero-scene>'s module runs after the document parses. A
         failed SDK load marks its tag, so the element doesn't wait on it. -->
    <script is:inline async src={SDK_URL} onerror="this.dataset.failed=''"></script>
    <link rel='preload' as='fetch' href={SCENE_URL} crossorigin='anonymous' />
  </Fragment>
  <main id='main' style='
      --display: grid;
      --position: relative;
    '>
    <section
      data-ui='layout'
      data-layout-size='bleed'
      style='
        --min-h: 0;
        --min-h--lg: calc(100svh - var(--ui-header-height));
      '
    >
      <div
        style='
          --display: subgrid-col;
          --position: relative;
          --h: auto;
          --h--lg: 124;
          --max-h: 100%;
          --max-h--lg: 70svh;
          --border-b: 1;
          --overflow: clip;
        '
      >
        <figure
          style='
            --display: grid;
            --position: absolute;
            --band: layout-bleed;
            --inset: 0;
            --z: 10;
          '
        >
          <HeroScene />

        </figure>
        <div style="
            --display: block;
            --display--lg: none;
            --position: absolute;
            --inset: 0;
            --bg: light-dark(var(--color-tint-300), var(--color-shade-400));
            --pointer-events: none;
            --z: 20;
          "></div>
        <div
          style='
            --display: grid;
            --place-items: center stretch;
            --band: layout-xl;
            --py: 11;
            --py--lg: 0;
            --top: var(--ui-header-height);
            --mb: 0;
            --h: auto;
            --h--lg: 100%;
            --z: 30;
          '
        >
          <hgroup
            style='
              --display: flex-col;
              --gap: 6;
              --w: 100%;
            '
          >
            <div
              style='
                --display: flex-col;
                --gap: 4;
                --text-align: center;
              '
            >
              <h1
                style='
                  --text-align: center;
                  --text: var(--color-muted-foreground);
                  --sr: only;
                '
              >
                {site.title}
              </h1>
              <p data-font='h1' style='
                  --text-align: center;
                  --text-wrap: balance;
                '>
                A web-native design system and primitives library.
              </p>
            </div>
            <div
              style='
                --display: flex-col;
                --items: center;
                --justify: center;
                --pb: 1;
                --gap: 6;
                --h: 100%;
              '
            >
              <p data-font='xl' style='
                  --max-w: 65ch;
                  --text-align: center;
                  --text-wrap: balance;
                '>
                Unified collection of baseline web primitives, style utilities,
                and CSS variables for no-build, low-build, and legacy migration projects.
              </p>
              <div
                style='
                  --display: flex;
                  --justify: center;
                  --gap: 2;
                '
              >
                <a
                  href='/docs/quick-start/'
                  data-ui='button'
                  data-button-variant='primary' style='--elevation: 2'>Quick start</a
                >
                <a
                  href='/playground'
                  data-ui='button'
                  data-button-variant='secondary'
                  style='--elevation: 2'
                  >Code playground <Icon name='arrow-right' /></a
                >
              </div>
            </div>
          </hgroup>
        </div>
      </div>

      <div style='--band: layout-bleed'>
        <ThemeBuilder />
      </div>
    </section>
  </main>
</BaseLayout>
