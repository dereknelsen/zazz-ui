---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { FilePen, Rss } from "@lucide/astro";

const posts = (
  await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// Frontmatter dates parse as UTC midnight; format in UTC so no build renders them a day early.
const format = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
---

<BaseLayout
  title="Blog"
  description="Releases, announcements, and engineering notes from Zazz."
>
  <main id="main" data-ui="layout" style="--py: 8">
    <div style="
        --display: flex-col;
        --band: layout-md;
        --gap: 11;
      ">
      <header>
        <div
          style="
            --display: flex;
            --items: center;
            --justify: space-between;
            --pb: 3;
            --gap: 2;
            --w: 100%;
            --border-b: 1;
          "
        >
          <p
            data-ui="text-eyebrow"
            style="--text: var(--color-muted-foreground)"
          >
            The Zazz Blog
          </p>
          <a href="/rss.xml" data-ui="badge" data-badge-variant="outline"
            ><Rss /> <span>RSS feed</span></a
          >
        </div>
      </header>
      {
        posts.length === 0 ? (
          <p style="--text: var(--color-muted-foreground)">
            Nothing published yet.
          </p>
        ) : (
          <ul style="
              --display: flex-col;
              --gap: 6;
              --divide-y: 1;
            ">
            {posts.map((post) => (
              <li data-ui="card" style="--pb: 6">
                <a
                  href={`/blog/${post.id}/`}
                  style="
                    --opacity--hover: 0.8;
                    --transition: var(--default-transition);
                  "
                >
                  <article style="
                      --display: flex-col;
                      --gap: 2;
                    ">
                    <div style="
                        --display: flex;
                        --items: center;
                        --gap: 2;
                      ">
                      {post.data.draft && (
                        <span data-ui="badge" data-badge-variant="warning">
                          <FilePen />
                          <span>Draft</span>
                        </span>
                      )}
                      <p
                        data-ui="text-xs"
                        style="--text: var(--color-muted-foreground)"
                      >
                        <time datetime={post.data.date.toISOString()}>
                          {format(post.data.date)}
                        </time>
                      </p>
                    </div>

                    <h2 data-ui="text-lg">
                      <span style="
                          --text-decoration: none;
                          --text: var(--color-foreground);
                        ">
                        {post.data.title}
                      </span>
                    </h2>
                    <p style="--text: var(--color-muted-foreground)">
                      {post.data.description}
                    </p>
                  </article>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </main>
</BaseLayout>
