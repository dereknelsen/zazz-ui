---
/**
 * Write Zazz HTML, see it render. The editor is Monaco (loaded on demand); the
 * output is a sandboxed iframe whose document is the site's own head (the kit
 * stylesheet, import map, polyfill, script, theme script) around the editor's
 * body. The code travels in the URL hash, so a page is a link.
 */
import { ArrowLeft, Copy, LoaderCircle, RotateCcw } from "@lucide/astro";
import PlaygroundLayout from "../layouts/PlaygroundLayout.astro";
import { siteHead } from "../lib/head.ts";
import { readExample } from "../lib/kit.ts";

const BLANK = `<main data-ui="layout" style="--py: 11">
  <section>
    <p data-ui="text-eyebrow">Playground</p>
    <h1 data-ui="text-h4" style="--mt: 1">Hello, Zazz</h1>
    <p style="--mt: 4; --max-w: var(--article-sm); --text: var(--color-muted-foreground)">
      Edit the HTML on the left. Identities in <code>data-ui</code>, presets in
      <code>data-&lt;primitive&gt;-*</code>, values as style utilities.
    </p>
    <div style="--mt: 6; --display: flex; --gap: 2; --flex-wrap: wrap">
      <button data-ui="button" data-button-variant="primary">Primary</button>
      <button data-ui="button" data-button-variant="outline">Outline</button>
      <button data-ui="button" data-button-variant="ghost">Ghost</button>
    </div>
  </section>
</main>
`;

const templates = [
  { id: "blank", label: "Blank page", html: BLANK },
  ...[
    ["button/button", "Buttons"],
    ["card/card", "Card"],
    ["layout/layout", "Layout bands"],
    ["navigation-menu/navigation-menu-simple", "Navigation menu"],
    ["dialog/dialog", "Dialog"],
    ["tabs/tabs", "Tabs"],
    ["input-group/input-group", "Input group"],
    ["table/table", "Table"],
    ["command/command-dialog", "Command palette"],
    ["carousel/carousel", "Carousel"],
    ["utilities/responsive-grid", "Responsive grid"],
  ].map(([id, label]) => ({ id, label, html: readExample(id) ?? "" })),
];

// `<` is escaped so the head's own <script> tags cannot close this one.
const data = JSON.stringify({ head: siteHead(), templates }).replace(/</g, "\\u003c");

// Production isolates user HTML in an opaque origin. Astro's dev server blocks
// every cross-site subresource request (its Sec-Fetch guard; `Origin: null`
// cannot be allow-listed), so in dev the frame stays same-origin instead.
const sandbox = import.meta.env.DEV
  ? "allow-scripts allow-same-origin allow-forms allow-modals"
  : "allow-scripts allow-forms allow-modals";
---

<PlaygroundLayout title="Playground" description="Write Zazz HTML and watch it render, then share the link.">
  <main
    id="main"
    data-playground
    style="
      --display: grid;
      --grid-template-rows: auto minmax(0, 1fr);
      --min-h: calc(100dvh - 3.5rem);
    "
  >
    <div
      data-ui="layout"
      data-layout-size="bleed"
      style="
        --p: 2;
        --border-b: 1;
        --bg: var(--color-card);
      "
    >
      <div
        style="
          --display: flex;
          --items: center;
          --gap: 2;
          --flex-wrap: wrap;
        "
      >
        <a href="/" data-ui="button" data-button-variant="outline">
          <ArrowLeft aria-hidden="true" />
          <span>Home</span>
        </a>
        <label data-ui="field" data-field-orientation="horizontal" style="--gap: 2; --max-w: 64; --w: 100%">
          <span data-ui="sr-only" data-field-slot="label">Template</span>
          <select data-ui="select" data-playground-template aria-label="Starter template">
            <button>
              <span aria-hidden="true" style="--text: var(--color-muted-foreground)">Template:</span> <selectedcontent></selectedcontent>
            </button>
            {templates.map((t) => <option value={t.id}>{t.label}</option>)}
          </select>
        </label>
        <div style="--display: flex; --gap: 1; --ml: auto">
          <span
            data-playground-status
            role="status"
            aria-live="polite"
            data-ui="text-xs"
            style="
              --display: inline-flex;
              --items: center;
              --gap: 1.5;
              --self: center;
              --mr: 2;
              --text: var(--color-muted-foreground);
              --opacity: 0;
              --transition: opacity 0.25s;
            "
          >
            <span data-spin style="--display: inline-flex"><LoaderCircle aria-hidden="true" /></span>
            Formatting styles…
          </span>
          
          <button type="button" data-ui="button" data-button-variant="outline" data-playground-copy>
            <Copy aria-hidden="true" /> <span>Copy link</span>
          </button>
          <button type="button" data-ui="button" data-button-variant="ghost" data-playground-reset>
            <RotateCcw aria-hidden="true" /> Reset
          </button>
        </div>
      </div>
    </div>

    <div
      style="
        --display: grid;
        --grid-template-cols: minmax(0, 1fr);
        --grid-template-cols--lg: minmax(0, 1fr) minmax(0, 1fr);
        --min-h: 0;
      "
      data-ui="divide-x"
    >
      <div data-playground-editor style="--min-h: 50dvh; --position: relative">
        <textarea
          data-playground-fallback
          aria-label="HTML"
          spellcheck="false"
          style="
            --w: 100%;
            --h: 100%;
            --min-h: 50dvh;
            --p: 4;
            --font-family: var(--font-family-mono);
            --font-size: var(--font-size-sm);
            --border: 0;
            --bg: var(--color-background);
            --text: var(--color-foreground);
          "></textarea>
      </div>
      <iframe
        data-playground-output
        title="Output: user-supplied HTML"
        sandbox={sandbox}
        referrerpolicy="no-referrer"
        style="
          --w: 100%;
          --h: 100%;
          --min-h: 50dvh;
          --border: 0;
          --bg: var(--color-background);
        "></iframe>
    </div>
  </main>

  <script type="application/json" data-playground-data set:html={data} />
  <script src="../scripts/playground.ts"></script>
</PlaygroundLayout>
