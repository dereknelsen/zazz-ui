---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteHead } from "../lib/head.ts";
import { ldJson, websiteLd } from "../lib/jsonld.ts";
import { site } from "../site.config.ts";
import og from "../assets/og.png";
import "../styles/site.css";

interface Props {
  title: string;
  description?: string;
  /** Schema.org objects for this page, after the site-wide `WebSite`. */
  jsonLd?: Record<string, unknown>[];
  /** `article` adds `article:published_time` from `published`. */
  ogType?: "website" | "article";
  published?: Date;
  /** The page has a Markdown twin at `index.md` (every page in `allPages()`). */
  markdown?: boolean;
}
const {
  title,
  description = site.description,
  jsonLd = [],
  ogType = "website",
  published,
  markdown = false,
} = Astro.props;
const pageTitle = title === site.name ? site.title : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url);
// Imported, not served from public/, so the URL carries a content hash and social
// cards (X caches by image URL for about a week) refetch whenever the file changes.
const ogImage = new URL(og.src, site.url);
---

<!doctype html>
<html lang="en" data-ui-navigation="swap">
  <head>
    <Fragment set:html={siteHead()} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} blog`}
      href="/rss.xml"
    />
    {
      markdown && (
        <link
          rel="alternate"
          type="text/markdown"
          href={`${Astro.url.pathname.replace(/\/?$/, "/")}index.md`}
        />
      )
    }
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    {
      ogType === "article" && published && (
        <meta
          property="article:published_time"
          content={published.toISOString()}
        />
      )
    }
    <meta property="og:site_name" content={site.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Zazz: a design system for the baseline web"
    />
    <meta name="twitter:card" content="summary_large_image" />
    {
      [websiteLd(), ...jsonLd].map((ld) => (
        <script type="application/ld+json" is:inline set:html={ldJson(ld)} />
      ))
    }
    <slot name="head" />
    <!-- Components ship their own scripts; this loads them after a swap navigation, which runs none. -->
    <script src="../scripts/islands.ts"></script>

    <!-- Guestbook -->
    <script
      defer
      src="https://guestbook.meridian.design/guestbook.js"
      data-website-id="3aab8403-e8c4-4c9d-b90a-e630f8119697"></script>
  </head>
  <body>
    <a
      href="#main"
      data-ui="button"
      data-button-variant="outline"
      style="
        --position: absolute;
        --top: 2;
        --left: 2;
        --translate: 0 -200%;
        --translate--focus-visible: 0 0;
        --z: 30;
      "
    >
      Skip to content
    </a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
